---
// Static public snapshot imported from decks@23697faa0d4517f00b5f0fa13db23c80a92e5f70.
const slides = [
  'title', 'room-check', 'spectrum', 'secret-tunnel', 'secret-tunnel-live',
  'mosaic', 'mosaic-live', 'age-of-empires', 'decks', 'kotoma', 'jam', 'aps',
  'chi', 'ecosystem',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>Rewild the Internet — Grisha Szep</title>
    <meta name="description" content="An interactive talk about reclaiming the internet as a place to explore, create, and play." />
    <link rel="canonical" href="https://gszep.com/talks/rewild/" />
    <meta property="og:title" content="Rewild the Internet — Grisha Szep" />
    <meta property="og:description" content="An interactive talk about reclaiming the internet as a place to explore, create, and play." />
    <meta property="og:url" content="https://gszep.com/talks/rewild/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://gszep.com/decks/rewild-open-projector/slides/assets/secret-tunnel-hero.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Rewild the Internet — Grisha Szep" />
    <meta name="twitter:description" content="An interactive talk about reclaiming the internet as a place to explore, create, and play." />
    <meta name="twitter:image" content="https://gszep.com/decks/rewild-open-projector/slides/assets/secret-tunnel-hero.jpg" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%B1%3C/text%3E%3C/svg%3E" />
    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; width: 100%; height: 100%; height: 100dvh; overflow: hidden; background: #111; color: #fff; font: 12px system-ui, sans-serif; overscroll-behavior: none; }
      #viewport { position: absolute; inset: 0; overflow: hidden; }
      #stage { position: absolute; left: 50%; top: 50%; width: 1280px; height: 720px; margin: -360px 0 0 -640px; transform-origin: center; touch-action: pan-y; }
      iframe { position: absolute; inset: 0; width: 1280px; height: 720px; border: 0; background: #fff; visibility: hidden; opacity: 0; transition: opacity 80ms linear; }
      iframe.active { visibility: visible; opacity: 1; }
      #controls { position: fixed; z-index: 2; left: 50%; bottom: max(8px, env(safe-area-inset-bottom)); display: flex; transform: translateX(-50%); background: rgba(0,0,0,.82); border: 1px solid #555; }
      button { min-width: 48px; height: 48px; border: 0; border-right: 1px solid #555; border-radius: 0; background: transparent; color: #fff; padding: 0 12px; font: 600 18px/48px system-ui,sans-serif; text-align: center; touch-action: manipulation; }
      button:last-child { border-right: 0; }
      button:hover { background: #333; }
      button:focus-visible { position: relative; outline: 2px solid #fff; outline-offset: -2px; }
      :fullscreen #controls { display: none; }
      @media (max-width:700px), (max-height:500px) {
        #controls { bottom: max(6px, env(safe-area-inset-bottom)); }
        button { min-width: 56px; height: 56px; font-size: 22px; line-height: 56px; padding: 0 14px; }
      }
    </style>
  </head>
  <body>
    <main id="viewport"><div id="stage"></div></main>
    <nav id="controls" aria-label="Presentation controls">
      <button id="prev" title="Previous slide (←)" aria-label="Previous slide">←</button>
      <button id="next" title="Next slide (→ or Space)" aria-label="Next slide">→</button>
      <button id="full" title="Full screen (F)" aria-label="Full screen">⛶</button>
    </nav>
    <script define:vars={{ slides }}>
      const params = new URLSearchParams(location.search);
      const stage = document.querySelector('#stage');
      const viewport = document.querySelector('#viewport');
      const controls = document.querySelector('#controls');
      const frames = [];
      let index = 0;
      const requested = Number(params.get('slide'));
      if (Number.isInteger(requested) && requested > 0 && requested <= slides.length) index = requested - 1;

      function bindSwipe(target) {
        let x = 0, y = 0, time = 0;
        target.addEventListener('touchstart', event => {
          if (event.touches.length !== 1) return;
          const touch = event.touches[0];
          x = touch.clientX; y = touch.clientY; time = Date.now();
        }, { passive: true });
        target.addEventListener('touchend', event => {
          if (!time || !event.changedTouches.length) return;
          const touch = event.changedTouches[0];
          const dx = touch.clientX - x, dy = touch.clientY - y, elapsed = Date.now() - time;
          time = 0;
          if (elapsed < 900 && Math.abs(dx) >= 50 && Math.abs(dx) > Math.abs(dy) * 1.2) show(index + (dx < 0 ? 1 : -1));
        }, { passive: true });
        target.addEventListener('touchcancel', () => { time = 0; }, { passive: true });
      }

      for (let i = 0; i < slides.length; i++) {
        const frame = document.createElement('iframe');
        frame.title = `Slide ${i + 1} of ${slides.length}`;
        frame.onload = () => {
          frame.contentWindow.addEventListener('keydown', onKey);
          bindSwipe(frame.contentDocument);
        };
        frame.src = `/decks/rewild-open-projector/slides/${encodeURIComponent(slides[i])}.html?lang=en`;
        frames.push(frame);
        stage.append(frame);
      }

      function updateUrl() {
        const url = new URL(location.href);
        url.search = '';
        url.searchParams.set('slide', String(index + 1));
        history.replaceState(null, '', url);
      }
      function show(next) {
        index = (next + frames.length) % frames.length;
        for (let i = 0; i < frames.length; i++) frames[i].classList.toggle('active', i === index);
        updateUrl();
      }
      function fit() {
        const reserved = document.fullscreenElement ? 0 : controls.getBoundingClientRect().height + 16 + parseFloat(getComputedStyle(controls).bottom || 0);
        viewport.style.bottom = `${reserved}px`;
        stage.style.transform = `scale(${Math.min(viewport.clientWidth / 1280, Math.max(1, viewport.clientHeight) / 720)})`;
      }
      function toggleFull() {
        document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
      }
      function onKey(event) {
        const key = event.key;
        if (['ArrowRight', 'ArrowDown', 'PageDown', ' ', 'Enter'].includes(key)) { event.preventDefault(); show(index + 1); }
        else if (['ArrowLeft', 'ArrowUp', 'PageUp', 'Backspace'].includes(key)) { event.preventDefault(); show(index - 1); }
        else if (key === 'Home') { event.preventDefault(); show(0); }
        else if (key === 'End') { event.preventDefault(); show(frames.length - 1); }
        else if (key.toLowerCase() === 'f') { event.preventDefault(); toggleFull(); }
      }
      document.querySelector('#prev').onclick = () => show(index - 1);
      document.querySelector('#next').onclick = () => show(index + 1);
      document.querySelector('#full').onclick = toggleFull;
      bindSwipe(viewport);
      addEventListener('resize', fit);
      addEventListener('orientationchange', fit);
      addEventListener('fullscreenchange', fit);
      addEventListener('keydown', onKey);
      fit();
      show(index);
    </script>
  </body>
</html>
