---
interface Props { lang?: 'en' | 'ja' }
const { lang = 'en' } = Astro.props;
const ja = lang === 'ja';
// year, central, low, high, projection? (estimates from published trends; see the post's notes)
const D: [number, number, number, number, boolean][] = [
  [2012, 0.62, 0.45, 0.75, false], [2013, 0.62, 0.45, 0.75, false], [2014, 0.61, 0.45, 0.75, false],
  [2015, 0.6, 0.45, 0.75, false], [2016, 0.6, 0.45, 0.75, false], [2017, 0.59, 0.45, 0.73, false],
  [2018, 0.57, 0.45, 0.7, false], [2019, 0.56, 0.45, 0.66, false], [2020, 0.56, 0.45, 0.62, false],
  [2021, 0.55, 0.45, 0.6, false], [2022, 0.55, 0.45, 0.6, false], [2023, 0.55, 0.45, 0.6, false],
  [2024, 0.48, 0.35, 0.58, false], [2025, 0.38, 0.25, 0.52, false], [2026, 0.38, 0.25, 0.52, false],
  [2027, 0.41, 0.2, 0.6, true], [2028, 0.43, 0.18, 0.65, true],
];
const X0 = 60, X1 = 640, Y0 = 20, Y1 = 230;
const x = (yr: number) => X0 + ((yr - 2012) / 16) * (X1 - X0);
const y = (v: number) => Y1 - v * (Y1 - Y0);
const band = D.map(([yr, , lo]) => `${x(yr)},${y(lo)}`).join(' ') + ' ' + [...D].reverse().map(([yr, , , hi]) => `${x(yr)},${y(hi)}`).join(' ');
const est = D.filter((d) => !d[4] || d[0] === 2027).filter((d) => d[0] <= 2026);
const proj = D.filter((d) => d[0] >= 2026);
const line = (arr: typeof D) => arr.map(([yr, c], i) => `${i ? 'L' : 'M'}${x(yr).toFixed(1)},${y(c).toFixed(1)}`).join('');
const T = ja
  ? { y: '新しい設備が必要な割合', est: '推定', proj: '予測', notes: [[2017, 'Transformer'], [2020, 'GPT-3'], [2024.7, '推論モデル']], aria: 'AIの進歩のうち新しい物理的な設備を必要とした割合の推移、2012〜2028年' }
  : { y: 'share needing new hardware', est: 'estimate', proj: 'projection', notes: [[2017, 'Transformer'], [2020, 'GPT-3'], [2024.7, 'reasoning models']], aria: 'Share of AI progress that needed new physical things, 2012 to 2028' };
---
<div class="strend">
  <svg viewBox="0 0 660 260" preserveAspectRatio="xMidYMid meet" aria-label={T.aria}>
    {[0, 0.25, 0.5, 0.75, 1].map((v) => (
      <g><line x1={X0} x2={X1} y1={y(v)} y2={y(v)} class="g" /><text x={X0 - 6} y={y(v) + 4} text-anchor="end" class="tick">{Math.round(v * 100)}%</text></g>
    ))}
    {[2012, 2016, 2020, 2024, 2028].map((yr) => (<text x={x(yr)} y={Y1 + 16} text-anchor="middle" class="tick">{yr}</text>))}
    <text x="14" y="125" transform="rotate(-90 14 125)" text-anchor="middle" class="tick">{T.y}</text>
    <polygon points={band} class="band" />
    <path d={line(est)} class="est" />
    <path d={line(proj)} class="proj" />
    {T.notes.map(([yr, label]) => (
      <g><line x1={x(yr as number)} x2={x(yr as number)} y1={Y0} y2={Y1} class="ev" /><text x={x(yr as number) + 3} y={Y0 + 10} class="tick">{label}</text></g>
    ))}
    <g transform="translate(470,200)" class="tick">
      <line x1="0" y1="0" x2="20" y2="0" class="est" /><text x="26" y="4">{T.est}</text>
      <line x1="80" y1="0" x2="100" y2="0" class="proj" /><text x="106" y="4">{T.proj}</text>
    </g>
  </svg>
</div>
<style>
  .strend { max-width: 760px; margin: 0 auto; font-family: ui-sans-serif, system-ui, sans-serif; overflow-x: auto; }
  .strend svg { width: 100%; min-width: 520px; height: auto; display: block; }
  .strend .g { stroke: var(--post-separator, #eee); stroke-dasharray: 2 3; }
  .strend .tick { fill: var(--post-caption, #737373); font-size: 11px; }
  .strend .band { fill: #6a4c93; opacity: 0.15; }
  .strend .est { fill: none; stroke: #6a4c93; stroke-width: 2.5; }
  .strend .proj { fill: none; stroke: #6a4c93; stroke-width: 2.5; stroke-dasharray: 5 4; }
  .strend .ev { stroke: var(--post-caption, #bbb); stroke-dasharray: 2 3; }
</style>
