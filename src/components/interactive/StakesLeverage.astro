---
interface Props { lang?: 'en' | 'ja' }
const { lang = 'en' } = Astro.props;
const ja = lang === 'ja';
const T = ja
  ? {
      s0: 'ソフトウェアのみ', s1: 'チップ・電力・ロボットすべて',
      stakes: '賭け金：1年先行の価値', mid: 'ミドルパワーの影響力（平均）', us: '米国', cn: '中国',
      peakS: '賭け金が最大', peakM: 'ミドルパワーの影響力が最大',
      y: '最大値に対する割合', aria: 'AIの進歩の物理的な割合に応じた、1年先行の価値とミドルパワーの影響力',
      note: '賭け金は、上のモデルで1年先行した側が持つ能力の倍率（対数）を最大値で割ったもの。影響力は国ごとの強さ（筆者の判断）の平均で、日本・台湾・韓国・オランダ・ドイツ・湾岸諸国・オーストラリアとカナダ・EU・英国・シンガポールを含む。',
    }
  : {
      s0: 'Software only', s1: 'Chips, power and robots',
      stakes: 'Stakes: what a one-year lead is worth', mid: "Middle powers' leverage (average)", us: 'US', cn: 'China',
      peakS: 'stakes peak', peakM: "middle powers' leverage peaks",
      y: 'share of its maximum', aria: "The value of a one-year lead and middle powers' leverage across the physical share of AI's progress",
      note: "Stakes: how many times more capability a one-year leader has in the model above, on a log scale, divided by its maximum. Leverage: the average of the country strengths (my judgement) for Japan, Taiwan, Korea, the Netherlands, Germany, the Gulf states, Australia and Canada, the EU, the UK and Singapore.",
    };
---

<div class="slv" id="slv" data-lang={lang}>
  <label class="slv-slider">
    <span class="slv-ends"><span>{T.s0}</span><span>{T.s1}</span></span>
    <input type="range" id="slv-s" min="0" max="1" step="0.01" value="0.4" />
  </label>
  <div class="slv-chart">
    <svg viewBox="0 0 660 300" preserveAspectRatio="xMidYMid meet" aria-label={T.aria}>
      <g id="slv-grid" class="grid"></g>
      <g class="axes"><line x1="70" y1="20" x2="70" y2="260" /><line x1="70" y1="260" x2="640" y2="260" /></g>
      <text x="16" y="140" transform="rotate(-90 16 140)" text-anchor="middle" class="axlabel">{T.y}</text>
      <path id="slv-us" class="l-us" />
      <path id="slv-cn" class="l-cn" />
      <path id="slv-stakes" class="l-stakes" />
      <path id="slv-mid" class="l-mid" />
      <g id="slv-peaks"></g>
      <line id="slv-marker" y1="20" y2="260" class="marker" />
    </svg>
  </div>
  <div class="slv-leg">
    <span><i class="sw stakes"></i>{T.stakes}</span>
    <span><i class="sw mid"></i>{T.mid}</span>
    <span><i class="sw us"></i>{T.us}</span>
    <span><i class="sw cn"></i>{T.cn}</span>
  </div>
  <p class="slv-read" id="slv-read" aria-live="polite"></p>
  <p class="slv-note">{T.note}</p>
</div>

<style is:global>
  .slv { width: 100%; max-width: 760px; margin: 0 auto; color: var(--post-text, #353535); font-family: ui-sans-serif, system-ui, sans-serif; }
  .slv-slider { display: block; }
  .slv-ends { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--post-caption, #737373); }
  .slv-slider input { width: 100%; accent-color: #6a4c93; }
  .slv-chart { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .slv svg { width: 100%; min-width: 560px; height: auto; display: block; }
  .slv .axes line { stroke: var(--post-separator, #bbb); }
  .slv .grid line { stroke: var(--post-separator, #eee); stroke-dasharray: 2 3; }
  .slv .grid text, .slv .axlabel, .slv .legend text, .slv .peak text { fill: var(--post-caption, #737373); font-size: 11px; }
  .slv .axlabel { font-size: 12px; }
  .slv path, .slv .legend line { fill: none; stroke-width: 2.5; }
  .slv .l-stakes { stroke: #6a4c93; }
  .slv .l-mid { stroke: #00798c; stroke-width: 3; }
  .slv .l-us { stroke: var(--post-caption, #999); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .slv .l-cn { stroke: #d1495b; stroke-width: 1.5; stroke-dasharray: 2 3; }
  .slv .marker { stroke: var(--post-heading, #1a1a1a); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .slv .peak circle { stroke: #fff; stroke-width: 1.5; }
  .slv-leg { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; justify-content: center; font-size: 0.8rem; color: var(--post-caption, #737373); margin-top: 0.3rem; }
  .slv-leg .sw { display: inline-block; width: 20px; height: 0; border-top: 3px solid; vertical-align: middle; margin-right: 0.35rem; }
  .slv-leg .stakes { border-color: #6a4c93; }
  .slv-leg .mid { border-color: #00798c; }
  .slv-leg .us { border-top: 2px dashed #999; }
  .slv-leg .cn { border-top: 2px dotted #d1495b; }
  .slv-read { text-align: center; font-size: 0.92rem; margin: 0.4rem 0; }
  .slv-read b { color: var(--post-heading, #1a1a1a); }
  .slv-note { font-size: 0.78rem; color: var(--post-caption, #737373); }
</style>

<script>
  import { DEFAULTS, rates, model, COUNTRIES, interp, middlePowerLeverage, getShared, setShared, onShared } from './physical-share/model';

  const root = document.getElementById('slv');
  if (root) {
    const ja = root.dataset.lang === 'ja';
    const $ = (id: string) => document.getElementById(id)!;
    const input = $('slv-s') as HTMLInputElement;
    const { gI, gP } = rates(DEFAULTS.giOom, DEFAULTS.tp);
    const X0 = 70, X1 = 640, Y0 = 20, Y1 = 260;
    const x = (v: number) => X0 + v * (X1 - X0);
    const y = (v: number) => Y1 - v * (Y1 - Y0);

    const N = 200;
    const ss = Array.from({ length: N + 1 }, (_, i) => i / N);
    const logLead = ss.map((v) => model(v, gI, gP).gE); // ln of the one-year lead multiple
    const maxLog = Math.max(...logLead);
    const stakes = logLead.map((v) => v / maxLog);
    const mid = ss.map((v) => middlePowerLeverage(v) / 3);
    const us = ss.map((v) => interp(v, COUNTRIES[0].score) / 3);
    const cn = ss.map((v) => interp(v, COUNTRIES[1].score) / 3);
    const line = (arr: number[]) => arr.map((v, i) => `${i ? 'L' : 'M'}${x(ss[i]).toFixed(1)},${y(v).toFixed(1)}`).join('');
    $('slv-stakes').setAttribute('d', line(stakes));
    $('slv-mid').setAttribute('d', line(mid));
    $('slv-us').setAttribute('d', line(us));
    $('slv-cn').setAttribute('d', line(cn));

    $('slv-grid').innerHTML = [0, 0.25, 0.5, 0.75, 1].map((v) => `<line x1="${X0}" x2="${X1}" y1="${y(v)}" y2="${y(v)}"/><text x="${X0 - 6}" y="${y(v) + 4}" text-anchor="end">${Math.round(v * 100)}%</text>`).join('')
      + [0, 0.25, 0.5, 0.75, 1].map((v) => `<text x="${x(v)}" y="${Y1 + 16}" text-anchor="middle">${Math.round(v * 100)}%</text>`).join('');

    const iS = stakes.indexOf(Math.max(...stakes));
    const iM = mid.indexOf(Math.max(...mid));
    const peak = (i: number, arr: number[], cls: string, label: string, color: string, below: boolean) =>
      `<g class="peak ${cls}"><circle cx="${x(ss[i])}" cy="${y(arr[i])}" r="5" fill="${color}"/><text x="${x(ss[i])}" y="${y(arr[i]) + (below ? 18 : -10)}" text-anchor="middle">${label}</text></g>`;
    $('slv-peaks').innerHTML = peak(iS, stakes, 's', ja ? '賭け金が最大' : 'stakes peak', '#6a4c93', false)
      + peak(iM, mid, 'm', ja ? 'ミドルパワーの影響力が最大' : "middle powers' leverage peaks", '#00798c', false)
      + `<g class="peak"><circle cx="${x(ss[iS])}" cy="${y(mid[iS])}" r="5" fill="#00798c"/><text x="${x(ss[iS]) + 8}" y="${y(mid[iS]) + 16}">${ja ? '賭け金が最大のときのミドルパワー' : 'middle powers where stakes peak'}</text></g>`;

    function render(s: number) {
      input.value = String(s);
      const mk = $('slv-marker');
      mk.setAttribute('x1', String(x(s)));
      mk.setAttribute('x2', String(x(s)));
      const lead = Math.exp(model(s, gI, gP).gE);
      const fmtLead = lead >= 10 ? lead.toFixed(0) : lead.toFixed(1);
      const lev = middlePowerLeverage(s);
      $('slv-read').innerHTML = ja
        ? `割合${Math.round(s * 100)}%では、1年先行の価値は<b>${fmtLead}倍</b>、ミドルパワーの影響力は平均<b>${lev.toFixed(1)}／3</b>`
        : `At ${Math.round(s * 100)}%, a one-year lead is worth <b>${fmtLead}×</b> and middle powers' leverage averages <b>${lev.toFixed(1)} out of 3</b>`;
    }
    input.addEventListener('input', () => { const s = parseFloat(input.value); render(s); setShared(s, 'slv'); });
    onShared('slv', render);
    render(getShared());
  }
</script>
