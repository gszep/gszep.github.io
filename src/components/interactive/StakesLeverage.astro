---
import { CATCH_UP } from './physical-share/model';
interface Props { lang?: 'en' | 'ja' }
const { lang = 'en' } = Astro.props;
const ja = lang === 'ja';
const T = ja
  ? {
      s0: 'ソフトウェアのみ', s1: 'チップ・電力・ロボットすべて',
      stakes: '保てる先行の大きさ（最大値に対する割合）', mid: '中堅国の合計シェア', us: '米国のシェア', cn: '中国のシェア',
      y: '割合', aria: 'AIの進歩の物理的な割合に応じた、保てる先行の大きさと、中堅国・米国・中国のシェア',
      adv: '前提を変える',
      cI: 'アイデアによる先行のうち、1年以内に競争相手がまねできる割合',
      cP: 'モノづくりによる先行のうち、1年以内に競争相手がまねできる割合',
      note: '保てる先行の大きさ：1年先行した側が持つ追加の能力のうち、競争相手に一部をまねされた後も残る分を、対数で表したものです（式は注にあります）。影響力：上の図の各段階で各グループが占めるシェアを、選んだ割合でその段階がどれほど重要かによって重みづけしたものです。中堅国は日本、台湾、韓国、オランダ、ドイツ、英国、湾岸諸国、オーストラリア、カナダです。',
    }
  : {
      s0: 'Software only', s1: 'Chips, power and robots',
      stakes: 'The lead you can keep (share of its highest value)', mid: "Middle powers' combined share", us: 'US share', cn: "China's share",
      y: 'share', aria: "The lead a one-year leader can keep, and the shares of middle powers, the US and China, across the physical share of AI's progress",
      adv: 'Change the assumptions',
      cI: 'How much of a lead from ideas rivals copy within a year',
      cP: 'How much of a lead from building rivals copy within a year',
      note: "The lead you can keep: a one-year leader's extra capability after rivals copy part of it, on a log scale (formula in the notes). Leverage: each group's share of the supply-chain stages in the chart above, weighted by how much each stage matters at the chosen mix. Middle powers: Japan, Taiwan, South Korea, the Netherlands, Germany, the UK, the Gulf states, Australia and Canada.",
    };
---

<div class="slv" data-lang={lang}>
  <label class="slv-slider">
    <span class="slv-ends"><span>{T.s0}</span><span>{T.s1}</span></span>
    <input type="range" class="slv-s" min="0" max="1" step="0.01" value="0.4" />
  </label>
  <div class="slv-chart">
    <svg class="slv-svg" viewBox="0 0 660 300" preserveAspectRatio="xMidYMid meet" aria-label={T.aria}>
      <g class="grid slv-grid"></g>
      <g class="axes"><line class="slv-ax-y" x1="70" y1="20" x2="70" y2="260" /><line class="slv-ax-x" x1="70" y1="260" x2="640" y2="260" /></g>
      <text class="axlabel slv-ylab" x="16" y="140" transform="rotate(-90 16 140)" text-anchor="middle">{T.y}</text>
      <path class="l-us slv-us" />
      <path class="l-cn slv-cn" />
      <path class="l-stakes slv-stakes" />
      <path class="l-mid slv-mid" />
      <g class="slv-peaks"></g>
      <line y1="20" y2="260" class="marker slv-marker" />
    </svg>
  </div>
  <div class="slv-leg">
    <span><i class="sw stakes"></i>{T.stakes}</span>
    <span><i class="sw mid"></i>{T.mid}</span>
    <span><i class="sw us"></i>{T.us}</span>
    <span><i class="sw cn"></i>{T.cn}</span>
  </div>
  <p class="slv-read" aria-live="polite"></p>
  <details class="slv-adv">
    <summary>{T.adv}</summary>
    <label>{T.cI}: <b class="slv-ci-v"></b><input type="range" class="slv-ci" min="0" max="1" step="0.05" value={CATCH_UP.cI} /></label>
    <label>{T.cP}: <b class="slv-cp-v"></b><input type="range" class="slv-cp" min="0" max="0.5" step="0.05" value={CATCH_UP.cP} /></label>
  </details>
  <p class="slv-note">{T.note}</p>
</div>

<style is:global>
  .slv { --slv-bg: #fff; width: 100%; max-width: 760px; margin: 0 auto; color: var(--post-text, #353535); font-family: ui-sans-serif, system-ui, sans-serif; }
  .dark .slv { --slv-bg: #000; }
  .slv-slider { display: block; }
  .slv-ends { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--post-caption, #737373); }
  .slv-slider input { width: 100%; accent-color: #6a4c93; }
  .slv svg { width: 100%; height: auto; display: block; }
  .slv .axes line { stroke: var(--post-separator, #bbb); }
  .slv .grid line { stroke: var(--post-separator, #eee); stroke-dasharray: 2 3; }
  .slv .grid text, .slv .axlabel, .slv .peak text { fill: var(--post-caption, #737373); font-size: 11px; }
  .slv .peak text { fill: var(--post-heading, #1a1a1a); paint-order: stroke; stroke: var(--slv-bg); stroke-width: 3px; stroke-linejoin: round; }
  .slv .axlabel { font-size: 12px; }
  .slv.narrow .grid text, .slv.narrow .axlabel, .slv.narrow .peak text { font-size: 12px; }
  .slv path { fill: none; stroke-width: 2.5; }
  .slv .l-stakes { stroke: #6a4c93; }
  .slv .l-mid { stroke: #00798c; stroke-width: 3.5; }
  .slv .l-us { stroke: var(--post-caption, #999); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .slv .l-cn { stroke: #d1495b; stroke-width: 1.5; stroke-dasharray: 2 3; }
  .slv .marker { stroke: var(--post-heading, #1a1a1a); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .slv .guide { stroke: #6a4c93; stroke-width: 1; stroke-dasharray: 1 3; }
  .slv .peak circle { stroke: var(--slv-bg); stroke-width: 1.5; }
  .slv-leg { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; justify-content: center; font-size: 0.8rem; color: var(--post-caption, #737373); margin-top: 0.3rem; }
  .slv-leg .sw { display: inline-block; width: 20px; height: 0; border-top: 3px solid; vertical-align: middle; margin-right: 0.35rem; }
  .slv-leg .stakes { border-color: #6a4c93; }
  .slv-leg .mid { border-top-width: 4px; border-color: #00798c; }
  .slv-leg .us { border-top: 2px dashed #999; }
  .slv-leg .cn { border-top: 2px dotted #d1495b; }
  .slv-read { text-align: center; font-size: 0.92rem; margin: 0.4rem 0; }
  .slv-read b { color: var(--post-heading, #1a1a1a); }
  .slv-adv { margin-top: 0.6rem; font-size: 0.85rem; }
  .slv-adv summary { cursor: pointer; color: var(--post-caption, #737373); }
  .slv-adv label { display: block; margin: 0.5rem 0; }
  .slv-adv input { width: 100%; accent-color: #6a4c93; }
  .slv-note { font-size: 0.78rem; color: var(--post-caption, #737373); }
</style>

<script>
  import { DEFAULTS, rates, model, keptLead, leverage, middlePowerLeverage, getShared, setShared, onShared } from './physical-share/model';

  document.querySelectorAll<HTMLElement>('.slv').forEach((root, idx) => {
    const ja = root.dataset.lang === 'ja';
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as unknown as E;
    const input = q<HTMLInputElement>('.slv-s');
    const ciIn = q<HTMLInputElement>('.slv-ci');
    const cpIn = q<HTMLInputElement>('.slv-cp');
    const src = `slv-${idx}`;
    const { gI, gP } = rates(DEFAULTS.giOom, DEFAULTS.tp);
    // Wide layout matches the static markup; the narrow one (container 560px or narrower) is taller and
    // uses slightly larger text so labels stay readable once the chart is scaled down.
    const WIDE = { W: 660, H: 300, X0: 70, X1: 640, Y0: 20, Y1: 260, axX: 16, xLabDy: 16, charW: ja ? 11 : 6, asc: 10, short: false };
    const NARROW = { W: 340, H: 326, X0: 50, X1: 322, Y0: 24, Y1: 294, axX: 12, xLabDy: 20, charW: ja ? 12 : 6.6, asc: 11, short: true };
    let L = WIDE;
    const x = (v: number) => L.X0 + v * (L.X1 - L.X0);
    const y = (v: number) => L.Y1 - v * (L.Y1 - L.Y0);

    const N = 200;
    const ss = Array.from({ length: N + 1 }, (_, i) => i / N);
    const mid = ss.map((v) => middlePowerLeverage(v));
    const us = ss.map((v) => leverage(v, ['US']));
    const cn = ss.map((v) => leverage(v, ['CN']));
    const line = (arr: number[]) => arr.map((v, i) => `${i ? 'L' : 'M'}${x(ss[i]).toFixed(1)},${y(v).toFixed(1)}`).join('');
    const attrs = (el: Element, a: Record<string, string | number>) => Object.entries(a).forEach(([k, v]) => el.setAttribute(k, String(v)));

    function layout() {
      const { W, H, X0, X1, Y0, Y1, axX, xLabDy, short } = L;
      root.classList.toggle('narrow', short);
      q('.slv-svg').setAttribute('viewBox', `0 0 ${W} ${H}`);
      attrs(q('.slv-ax-y'), { x1: X0, x2: X0, y1: Y0, y2: Y1 });
      attrs(q('.slv-ax-x'), { x1: X0, x2: X1, y1: Y1, y2: Y1 });
      const cy = (Y0 + Y1) / 2;
      attrs(q('.slv-ylab'), { x: axX, y: cy, transform: `rotate(-90 ${axX} ${cy})` });
      attrs(q('.slv-marker'), { y1: Y0, y2: Y1 });
      q('.slv-mid').setAttribute('d', line(mid));
      q('.slv-us').setAttribute('d', line(us));
      q('.slv-cn').setAttribute('d', line(cn));
      q('.slv-grid').innerHTML = [0, 0.25, 0.5, 0.75, 1].map((v) => `<line x1="${X0}" x2="${X1}" y1="${y(v)}" y2="${y(v)}"/><text x="${X0 - 6}" y="${y(v) + 4}" text-anchor="end">${Math.round(v * 100)}%</text>`).join('')
        + [0, 0.25, 0.5, 0.75, 1].map((v) => `<text x="${x(v)}" y="${Y1 + xLabDy}" text-anchor="middle">${Math.round(v * 100)}%</text>`).join('');
    }

    const iMidMax = mid.indexOf(Math.max(...mid));
    const iMidMin = mid.indexOf(Math.min(...mid));
    let stakes: number[] = [];

    // Place each label above or below its point, wherever it crosses the fewest curves and earlier labels.
    type Box = { x0: number; x1: number; y0: number; y1: number };
    const textW = (t: string) => t.length * L.charW;
    function placeLabel(px: number, py: number, text: string, taken: Box[]) {
      const { X0, X1, Y1, asc } = L;
      const w = textW(text);
      // The solid curves carry the labels' meaning, so crossing them costs far more than crossing the dashed ones.
      const curves: [number[], number][] = [[stakes, 20], [mid, 20], [us, 2], [cn, 2]];
      const opts: { anchor: string; tx: number; bx0: number; dy: number }[] = [];
      for (const dy of [-10, 18, -22, 30, -34, 42, 4]) {
        const centred = px - w / 2 < X0 + 4 ? 'start' : px + w / 2 > X1 ? 'end' : 'middle';
        for (const anchor of new Set([centred, 'start', 'end'])) {
          if (dy === 4 && anchor === 'middle') continue;
          const tx = anchor === 'start' ? Math.max(X0 + 4, px + (dy === 4 ? 9 : -4)) : anchor === 'end' ? px - (dy === 4 ? 9 : -4) : px;
          const bx0 = anchor === 'start' ? tx : anchor === 'end' ? tx - w : tx - w / 2;
          if (bx0 < X0 + 2 || bx0 + w > X1 + 15) continue;
          opts.push({ anchor, tx, bx0, dy });
        }
      }
      let best = { cost: Infinity, o: opts[0], box: { x0: 0, x1: 0, y0: 0, y1: 0 } };
      for (const o of opts) {
        const ty = py + o.dy;
        const box = { x0: o.bx0, x1: o.bx0 + w, y0: ty - asc, y1: ty + 2 };
        if (box.y0 < 0 || box.y1 > Y1 - 2) continue;
        let cost = 0;
        for (const [arr, wt] of curves) arr.forEach((v, i) => {
          const cx = x(ss[i]), cy = y(v);
          if (cx >= box.x0 - 2 && cx <= box.x1 + 2 && cy >= box.y0 - 4 && cy <= box.y1 + 4) cost += wt;
        });
        for (const b of taken) if (b.x0 < box.x1 && box.x0 < b.x1 && b.y0 < box.y1 && box.y0 < b.y1) cost += 1000;
        cost += Math.abs(o.dy) / 100 + (o.anchor === 'middle' ? 0 : 0.5) + (o.dy === 4 ? 3 : 0);
        if (cost < best.cost) best = { cost, o, box };
      }
      taken.push(best.box);
      return `<text x="${best.o.tx}" y="${py + best.o.dy}" text-anchor="${best.o.anchor}">${text}</text>`;
    }

    function drawCurve() {
      const cI = parseFloat(ciIn.value), cP = parseFloat(cpIn.value);
      q('.slv-ci-v').textContent = `${Math.round(cI * 100)}%`;
      q('.slv-cp-v').textContent = `${Math.round(cP * 100)}%`;
      const kept = ss.map((v) => keptLead(v, gI, gP, cI, cP));
      const maxK = Math.max(...kept) || 1;
      stakes = kept.map((v) => v / maxK);
      q('.slv-stakes').setAttribute('d', line(stakes));

      const iS = stakes.indexOf(Math.max(...stakes));
      const dot = (i: number, arr: number[], color: string, r = 5) => `<circle cx="${x(ss[i])}" cy="${y(arr[i])}" r="${r}" fill="${color}"/>`;
      const taken: Box[] = [];
      const pts = [[iS, stakes], [iMidMax, mid], [iMidMin, mid], [iS, mid]] as const;
      pts.forEach(([i, arr]) => taken.push({ x0: x(ss[i]) - 6, x1: x(ss[i]) + 6, y0: y(arr[i]) - 6, y1: y(arr[i]) + 6 }));
      const labels = [
        placeLabel(x(ss[iS]), y(stakes[iS]), ja ? '先行の価値が最大' : 'a lead is worth most', taken),
        placeLabel(x(ss[iMidMax]), y(mid[iMidMax]), ja ? '中堅国が最も強い' : 'middle powers strongest', taken),
        placeLabel(x(ss[iMidMin]), y(mid[iMidMin]), ja ? '中堅国が最も弱い' : 'middle powers weakest', taken),
      ];
      q('.slv-peaks').innerHTML = `<line class="guide" x1="${x(ss[iS])}" x2="${x(ss[iS])}" y1="${y(stakes[iS])}" y2="${y(mid[iS])}"/>`
        + `<g class="peak">${dot(iS, stakes, '#6a4c93')}${dot(iMidMax, mid, '#00798c')}${dot(iMidMin, mid, '#00798c')}${dot(iS, mid, '#00798c', 3.5)}${labels.join('')}</g>`;
    }

    const fmtX = (v: number) => (v >= 10 ? v.toFixed(0) : v.toFixed(1));
    function render(s: number) {
      input.value = String(s);
      const mk = q('.slv-marker');
      mk.setAttribute('x1', String(x(s)));
      mk.setAttribute('x2', String(x(s)));
      const cI = parseFloat(ciIn.value), cP = parseFloat(cpIn.value);
      const lead = fmtX(Math.exp(model(s, gI, gP).gE));
      const kept = fmtX(Math.exp(keptLead(s, gI, gP, cI, cP)));
      const X = Math.round(s * 100);
      const M = Math.round(middlePowerLeverage(s) * 100);
      const U = Math.round(leverage(s, ['US']) * 100);
      const C = Math.round(leverage(s, ['CN']) * 100);
      q('.slv-read').innerHTML = ja
        ? `割合${X}%では、1年先行で得られる<b>${lead}倍</b>の能力は、競争相手が追いつくと<b>${kept}倍</b>に縮みます。加重したサプライチェーンのうち、中堅国は<b>${M}%</b>、米国は<b>${U}%</b>、中国は<b>${C}%</b>を占めます。`
        : `At ${X}%, a one-year lead of <b>${lead}×</b> shrinks to <b>${kept}×</b> once rivals catch up; middle powers hold <b>${M}%</b> of the weighted supply chain, the US <b>${U}%</b> and China <b>${C}%</b>.`;
    }

    [ciIn, cpIn].forEach((el) => el.addEventListener('input', () => { drawCurve(); render(parseFloat(input.value)); }));
    input.addEventListener('input', () => { const s = parseFloat(input.value); render(s); setShared(s, src); });
    onShared(src, render);
    let laidOut = false;
    const pick = () => {
      const next = root.clientWidth <= 560 ? NARROW : WIDE;
      if (laidOut && next === L) return;
      laidOut = true;
      L = next;
      layout();
      drawCurve();
      render(parseFloat(input.value));
    };
    new ResizeObserver(pick).observe(root);
    input.value = String(getShared());
    pick();
  });
</script>
