---
interface Props {
  lang?: 'en' | 'ja';
}

const { lang = 'en' } = Astro.props;
const labels = lang === 'ja'
  ? {
      full: 'フルスクリーンでツリーを開く',
      note: '見本データのみ。この中での操作は何も保存されません。',
    }
  : {
      full: 'Open full-screen tree',
      note: 'Sample data only. Nothing you do inside it is stored.',
    };
---

<figure class="talent-tree l-screen">
  <iframe
    src="/talent-engine-tree/"
    title="Talent Engine — student achievement tree (concept prototype)"
    loading="lazy"
  ></iframe>
  <figcaption>
    <span>{labels.note}</span>
    <a class="talent-tree__open" href="/talent-engine-tree/" target="_blank" rel="noopener">{labels.full} ↗</a>
  </figcaption>
</figure>

<style>
  .post-content figure.talent-tree {
    margin: 0 0 3rem;
    background: #070c18;
  }
  .post-content figure.talent-tree iframe {
    display: block;
    width: 100%;
    height: min(78vh, 820px);
    min-height: 460px;
    border: 0;
    background: #070c18;
  }
  .post-content figure.talent-tree figcaption {
    max-width: none;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1rem 1.1rem;
    background: #070c18;
    color: #cbc5b4;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .post-content figure.talent-tree .talent-tree__open {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border: 1px solid rgba(242, 201, 78, 0.55);
    border-radius: 999px;
    color: #f2c94c;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .post-content figure.talent-tree .talent-tree__open:hover {
    background: rgba(242, 201, 78, 0.12);
  }
</style>
