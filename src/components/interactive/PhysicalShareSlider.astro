---
interface Props { lang?: 'en' | 'ja' }
const { lang = 'en' } = Astro.props;
const ja = lang === 'ja';
const T = ja
  ? {
      s0: 'ソフトウェアのみ', sNow: '現在（概算）', s1: 'チップ・電力・ロボットすべて',
      ylab: '倍増にかかる時間', cap: 'AIの能力', phys: '物理的な設備の建設', robot: 'ロボット生産',
      ideas: 'アイデアが遅い側', atoms: '物理的な建設が遅い側',
      lev: 'どの国の影響力が強まるか（濃いほど強い。カーソルを合わせると理由が表示されます）',
      adv: '前提を変える', gi: 'アイデアだけで能力が伸びる速さ', tp: '物理的な建設が倍増する最短期間',
      note: 'モデル：AIの能力は、より良いアイデアと、より多くの物理的な設備という二つの材料のうち、遅い方の速さでしか伸びない。アイデアの速さと建設の速さは調整できる仮定。銅と磁石の数値は後に出てくる素材の図の既定値と同じ。国ごとの強さは筆者の判断。日付は例示として読んでほしい。',
      aria: 'AIの進歩のうち物理的な設備を必要とする割合と、成長の速さ・素材不足の時期・各国の影響力の関係',
    }
  : {
      s0: 'Software only', sNow: 'Today (rough)', s1: 'Chips, power and robots',
      ylab: 'time to double', cap: 'AI capability', phys: 'physical build-out', robot: 'robot production',
      ideas: 'ideas are the slower step', atoms: 'building is the slower step',
      lev: 'Whose leverage grows (darker = stronger; hover for the reason)',
      adv: 'Change the assumptions', gi: 'How fast ideas alone raise capability', tp: 'Fastest doubling time of physical build-out',
      note: 'Model: AI capability grows only as fast as the slower of its two ingredients, better ideas and more physical things. The speeds of ideas and of building are adjustable assumptions; copper and magnet inputs match the materials chart further down; country strengths are my judgement. Treat the dates as illustrations.',
      aria: 'How the physical share of AI progress changes growth speed, material shortage dates and country leverage',
    };
---

<div class="pss" id="pss" data-lang={lang}>
  <label class="pss-slider">
    <span class="pss-ends"><span>{T.s0}</span><span>{T.s1}</span></span>
    <input type="range" id="pss-s" min="0" max="1" step="0.01" value="0.45" aria-describedby="pss-share" />
    <span class="pss-now" id="pss-nowtick">▲ {T.sNow}</span>
  </label>
  <p class="pss-share" id="pss-share" aria-live="polite"></p>

  <div class="pss-chart">
  <svg viewBox="0 0 660 330" preserveAspectRatio="xMidYMid meet" aria-label={T.aria}>
    <rect id="pss-band" x="96" y="20" width="0" height="270" class="band" />
    <text id="pss-band-l" x="102" y="34" class="bandtxt">{T.ideas}</text>
    <text id="pss-band-r" x="634" y="34" text-anchor="end" class="bandtxt">{T.atoms}</text>
    <g id="pss-grid" class="grid"></g>
    <g class="axes"><line x1="96" y1="20" x2="96" y2="290" /><line x1="96" y1="290" x2="640" y2="290" /></g>
    <text x="16" y="155" transform="rotate(-90 16 155)" text-anchor="middle" class="axlabel">{T.ylab}</text>
    <path id="pss-robot" class="l-robot" />
    <path id="pss-phys" class="l-phys" />
    <path id="pss-cap" class="l-cap" />
    <line id="pss-marker" y1="20" y2="290" class="marker" />
    <g class="legend" transform="translate(110,56)">
      <line x1="0" y1="0" x2="22" y2="0" class="l-cap" /><text x="28" y="4">{T.cap}</text>
      <line x1="0" y1="18" x2="22" y2="18" class="l-phys" /><text x="28" y="22">{T.phys}</text>
      <line x1="0" y1="36" x2="22" y2="36" class="l-robot" /><text x="28" y="40">{T.robot}</text>
    </g>
  </svg>
  </div>

  <div class="pss-cells" aria-live="polite">
    <div><span id="pss-c1"></span></div>
    <div><span id="pss-c2"></span></div>
    <div><span id="pss-c3"></span></div>
    <div><span id="pss-c4"></span></div>
  </div>

  <p class="pss-levlab">{T.lev}</p>
  <div class="pss-lev" id="pss-lev"></div>

  <details class="pss-adv">
    <summary>{T.adv}</summary>
    <label>{T.gi}: <b id="pss-gi-v"></b><input type="range" id="pss-gi" min="0.3" max="3" step="0.1" value="1" /></label>
    <label>{T.tp}: <b id="pss-tp-v"></b><input type="range" id="pss-tp" min="0.5" max="4" step="0.1" value="1.5" /></label>
  </details>
  <p class="pss-note">{T.note}</p>
</div>

<style is:global>
  .pss { width: 100%; max-width: 760px; margin: 0 auto; color: var(--post-text, #353535); font-family: ui-sans-serif, system-ui, sans-serif; }
  .pss-chart { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .pss svg { width: 100%; min-width: 560px; height: auto; display: block; }
  .pss-slider { display: block; position: relative; padding-bottom: 1.2rem; }
  .pss-ends { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--post-caption, #737373); }
  .pss-slider input { width: 100%; accent-color: #6a4c93; }
  .pss-now { position: absolute; left: 45%; transform: translateX(-50%); bottom: 0; font-size: 0.75rem; color: var(--post-caption, #737373); white-space: nowrap; }
  .pss-share { text-align: center; font-weight: 600; margin: 0.2rem 0 0.4rem; color: var(--post-heading, #1a1a1a); }
  .pss .axes line { stroke: var(--post-separator, #bbb); }
  .pss .grid line { stroke: var(--post-separator, #eee); stroke-dasharray: 2 3; }
  .pss .grid text, .pss .axlabel, .pss .legend text, .pss .bandtxt { fill: var(--post-caption, #737373); font-size: 11px; }
  .pss .axlabel { font-size: 12px; }
  .pss path, .pss .legend line { fill: none; stroke-width: 2.5; }
  .pss .l-cap { stroke: #6a4c93; }
  .pss .l-phys { stroke: #d1495b; }
  .pss .l-robot { stroke: #edae49; stroke-dasharray: 6 4; }
  .pss .band { fill: #6a4c93; opacity: 0.08; }
  .pss .marker { stroke: var(--post-heading, #1a1a1a); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .pss-cells { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin: 0.6rem 0; }
  .pss-cells div { border: 1px solid var(--post-separator, #e5e5e5); border-radius: 6px; padding: 0.5rem 0.7rem; font-size: 0.9rem; }
  .pss-cells b { color: var(--post-heading, #1a1a1a); }
  .pss-levlab { font-size: 0.8rem; color: var(--post-caption, #737373); margin: 0.6rem 0 0.3rem; }
  .pss-lev { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .pss-lev span { font-size: 0.78rem; padding: 0.25rem 0.55rem; border-radius: 999px; cursor: help; transition: background-color 0.2s, color 0.2s; border: 1px solid rgba(0, 61, 91, 0.25); }
  .pss-adv { margin-top: 0.8rem; font-size: 0.85rem; }
  .pss-adv summary { cursor: pointer; color: var(--post-caption, #737373); }
  .pss-adv label { display: block; margin: 0.5rem 0; }
  .pss-adv input { width: 100%; accent-color: #6a4c93; }
  .pss-note { font-size: 0.78rem; color: var(--post-caption, #737373); margin-top: 0.6rem; }
  @media (max-width: 560px) { .pss-cells { grid-template-columns: 1fr; } }
</style>

<script>
  const root = document.getElementById('pss');
  if (root) {
    const ja = root.dataset.lang === 'ja';
    const $ = (id: string) => document.getElementById(id)!;
    const sIn = $('pss-s') as HTMLInputElement;
    const giIn = $('pss-gi') as HTMLInputElement;
    const tpIn = $('pss-tp') as HTMLInputElement;

    // Baselines when growth does not need new things (my assumptions).
    const GB = Math.log(1.05);      // data-centre build-out, 5%/yr
    const GRB = Math.log(2) / 3;    // robot production doubles every 3 years
    // Copper and magnet inputs match the MaterialRace defaults.
    const CU = { ratio: Math.log((0.10 * 28000) / (18 * 60)), g: Math.log(1.02) };
    const MAG = { ratio: Math.log((0.30 * 226) / (100e3 * 2.5 / 1e6)), g: Math.log(1.08) };
    const START = 2026;

    // [score at s=0, 0.5, 1] on 0–3, my judgement.
    const C: [string, string, string, string, number[]][] = [
      ['US', '米国', 'Owns most existing AI computers and the leading models', '既存のAI計算資源と最先端モデルの大半を持つ', [3, 2.5, 1.5]],
      ['China', '中国', 'Refining, magnets, robots and fast power build-out; less compute', '精錬・磁石・ロボット・電源の急速な建設。計算資源は少ない', [1, 2, 3]],
      ['Japan', '日本', 'Chip materials and tools; robot gears', '半導体材料と製造装置、ロボット用の歯車', [1, 3, 2]],
      ['Taiwan', '台湾', 'Makes the most advanced chips', '最先端チップの製造', [1, 3, 2]],
      ['Korea', '韓国', 'AI memory chips; grid equipment', 'AI用メモリ、送電設備', [1, 3, 1.5]],
      ['Netherlands', 'オランダ', 'Chipmaking lithography machines', '半導体の露光装置', [0.5, 3, 1.5]],
      ['Germany', 'ドイツ', 'Grid equipment, machinery, optics', '送電設備・機械・光学', [0.5, 1.5, 2.5]],
      ['Gulf states', '湾岸諸国', 'Cheap power and capital; sulfur and helium; computers hosted there', '安価な電力と資本、硫黄とヘリウム、国内に置かれた計算資源', [1.5, 2, 3]],
      ['Australia & Canada', 'オーストラリア・カナダ', 'Minerals, uranium, capital', '鉱物・ウラン・資本', [0.5, 1.5, 3]],
      ['DRC, Indonesia, Chile', 'コンゴ・インドネシア・チリ', 'Cobalt, nickel, copper', 'コバルト・ニッケル・銅', [0, 1, 2.5]],
      ['EU', 'EU', 'Market rules; chipmaking tools', '市場のルール、半導体製造装置', [1, 2, 1.5]],
      ['UK', '英国', 'AI safety institute and research labs; little heavy industry', 'AI安全研究所と研究拠点。重工業は少ない', [2, 1.5, 0.5]],
      ['Singapore', 'シンガポール', 'A neutral meeting place; licences for data centres', '中立的な対話の場、データセンターの免許', [1.5, 1.5, 1.5]],
    ];
    const lev = $('pss-lev');
    const chips = C.map(([en, jn, ren, rjn]) => {
      const el = document.createElement('span');
      el.textContent = ja ? jn : en;
      el.title = ja ? rjn : ren;
      lev.appendChild(el);
      return el;
    });

    const X0 = 96, X1 = 640, Y0 = 20, Y1 = 290;
    const LMIN = Math.log10(1 / 24), LMAX = Math.log10(50); // two weeks to 50 years
    const x = (s: number) => X0 + s * (X1 - X0);
    const y = (yrs: number) => {
      const l = Math.min(LMAX, Math.max(LMIN, Math.log10(yrs)));
      return Y1 - ((l - LMIN) / (LMAX - LMIN)) * (Y1 - Y0);
    };

    const grid = $('pss-grid');
    const ticks: [number, string, string][] = [[1 / 12, '1 month', '1か月'], [0.5, '6 months', '6か月'], [1, '1 year', '1年'], [5, '5 years', '5年'], [20, '20 years', '20年']];
    grid.innerHTML = ticks.map(([v, en, jn]) => `<line x1="${X0}" x2="${X1}" y1="${y(v)}" y2="${y(v)}"/><text x="${X0 - 6}" y="${y(v) + 4}" text-anchor="end">${ja ? jn : en}</text>`).join('')
      + [0, 0.25, 0.5, 0.75, 1].map((v) => `<text x="${x(v)}" y="${Y1 + 16}" text-anchor="middle">${Math.round(v * 100)}%</text>`).join('');

    function model(s: number, gI: number, gP: number) {
      const gE = s <= 0 ? gI : s >= 1 ? gP : Math.min(gI / (1 - s), gP / s);
      const gPhys = Math.max(GB, s * gE);
      const gRob = Math.max(GRB, s * gPhys);
      return { gE, gPhys, gRob };
    }
    const year = (ratio: number, gd: number, gs: number) => (gd <= gs ? Infinity : START + ratio / (gd - gs));
    const fmtYear = (yr: number) => (yr > 2050 ? (ja ? '2050年より後' : 'after 2050') : (ja ? `${Math.round(yr)}年ごろ` : `around ${Math.round(yr)}`));

    function path(f: (s: number) => number) {
      let d = '';
      for (let i = 0; i <= 200; i++) {
        const s = i / 200;
        d += `${i ? 'L' : 'M'}${x(s).toFixed(1)},${y(Math.LN2 / f(s)).toFixed(1)}`;
      }
      return d;
    }

    function render() {
      const s = parseFloat(sIn.value);
      const gIoom = parseFloat(giIn.value);
      const tp = parseFloat(tpIn.value);
      const gI = gIoom * Math.LN10;
      const gP = Math.LN2 / tp;
      $('pss-gi-v').textContent = ja ? `年${Math.pow(10, gIoom).toFixed(gIoom < 1 ? 1 : 0)}倍` : `${Math.pow(10, gIoom).toFixed(gIoom < 1 ? 1 : 0)}× a year`;
      $('pss-tp-v').textContent = ja ? `${tp.toFixed(1)}年` : `${tp.toFixed(1)} years`;

      ($('pss-cap') as unknown as SVGPathElement).setAttribute('d', path((v) => model(v, gI, gP).gE));
      ($('pss-phys') as unknown as SVGPathElement).setAttribute('d', path((v) => model(v, gI, gP).gPhys));
      ($('pss-robot') as unknown as SVGPathElement).setAttribute('d', path((v) => model(v, gI, gP).gRob));
      const sStar = gP / (gI + gP);
      $('pss-band').setAttribute('width', String(x(sStar) - X0));
      const mk = $('pss-marker');
      mk.setAttribute('x1', String(x(s)));
      mk.setAttribute('x2', String(x(s)));

      const m = model(s, gI, gP);
      const pct = Math.round(s * 100);
      $('pss-share').textContent = ja ? `AIの進歩の約${pct}%が新しい物理的な設備を必要とする` : `About ${pct}% of AI's progress needs new physical things`;
      sIn.setAttribute('aria-valuetext', $('pss-share').textContent || '');
      const months = (12 * Math.LN2) / m.gE;
      const lead = Math.exp(m.gE);
      const fmtLead = lead >= 10 ? lead.toFixed(0) : lead.toFixed(1);
      $('pss-c1').innerHTML = ja ? `AIの能力は<b>${months < 1 ? months.toFixed(1) : months.toFixed(0)}か月</b>ごとに倍増` : `AI capability doubles every <b>${months < 1 ? months.toFixed(1) : months.toFixed(0)} months</b>`;
      $('pss-c2').innerHTML = ja ? `1年先行すれば能力は<b>${fmtLead}倍</b>` : `A one-year lead means <b>${fmtLead}×</b> the capability`;
      $('pss-c3').innerHTML = ja ? `データセンター用の銅が足りなくなるのは<b>${fmtYear(year(CU.ratio, m.gPhys, CU.g))}</b>` : `Copper for data centres runs short <b>${fmtYear(year(CU.ratio, m.gPhys, CU.g))}</b>`;
      $('pss-c4').innerHTML = ja ? `ロボット用の磁石が足りなくなるのは<b>${fmtYear(year(MAG.ratio, m.gRob, MAG.g))}</b>` : `Magnets for robots run short <b>${fmtYear(year(MAG.ratio, m.gRob, MAG.g))}</b>`;

      chips.forEach((el, i) => {
        const [a, b, c] = C[i][4];
        const sc = s <= 0.5 ? a + (b - a) * (s / 0.5) : b + (c - b) * ((s - 0.5) / 0.5);
        const alpha = 0.06 + 0.29 * sc;
        el.style.backgroundColor = `rgba(0, 61, 91, ${alpha.toFixed(2)})`;
        el.style.color = alpha > 0.5 ? '#fff' : '';
      });
    }

    [sIn, giIn, tpIn].forEach((el) => el.addEventListener('input', render));
    render();
  }
</script>
