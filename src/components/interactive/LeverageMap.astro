---
import { COUNTRIES, STAGES, type CountryKey } from './physical-share/model';
interface Props { lang?: 'en' | 'ja' }
const { lang = 'en' } = Astro.props;
const ja = lang === 'ja';
const T = ja
  ? {
      stage: '工程', total: '加重合計', s0: 'ソフトウェアのみ', s1: 'チップ・電力・ロボットすべて',
      aria: '鉱山からAIモデルまで、各工程で影響力を持つ国',
      key: '濃さは、世界の供給に占めるシェアに、選んだ割合でその工程がどれほど重要かを掛け合わせたものです。● は2019〜26年に供給が制限されたことを示します。行ごとに測り方が異なるため、セルにカーソルを合わせると詳細が表示されます。',
    }
  : {
      stage: 'Stage', total: 'Weighted total', s0: 'Software only', s1: 'Chips, power and robots',
      aria: 'Who holds leverage, from mines to models',
      key: 'Shading = share of world supply × how much that stage matters at the chosen mix. ● = supply restricted 2019–26. Measures differ by row; hover a cell for detail.',
    };
const ABBR: Partial<Record<CountryKey, [string, string]>> = {
  CN: ['CN', '中国'], JP: ['JP', '日本'], TW: ['TW', '台湾'], KR: ['KR', '韓国'], NL: ['NL', '蘭'], DE: ['DE', '独'],
  GULF: ['Gulf', '湾岸'], AUCA: ['AU/CA', '豪加'], PROD: ['Producers', '資源国'], OTH: ['Other', '他'],
};
const rgb = (k: CountryKey) => {
  const c = COUNTRIES.find((x) => x.k === k)!;
  return k === 'US' ? '48,99,142' : k === 'CN' ? '209,73,91' : c.middle ? '0,121,140' : '115,115,115';
};
const fmt = (v: number | undefined) => (!v ? '' : v < 5 ? '<5%' : `${Math.round(v)}%`);
---
<div class="levmap" data-lang={lang}>
  <label class="lm-slider">
    <span class="lm-ends"><span>{T.s0}</span><span class="lm-val"></span><span>{T.s1}</span></span>
    <input type="range" min="0" max="1" step="0.01" value="0.4" class="lm-s" />
  </label>
  <p class="lm-read" aria-live="polite"></p>
  <div class="scroll">
    <table aria-label={T.aria}>
      <thead>
        <tr>
          <th class="m">{T.stage}</th>
          {COUNTRIES.map((c) => {
            const full = ja ? c.ja : c.en;
            const ab = ABBR[c.k]?.[ja ? 1 : 0] ?? full;
            return <th title={full}><span class="full">{full}</span><span class="abbr" aria-hidden="true">{ab}</span></th>;
          })}
        </tr>
      </thead>
      <tbody>
        {STAGES.map((st, i) => (
          <tr data-i={i}>
            <td class="m"><span class="nm">{ja ? st.ja : st.en}</span><span class="wbar"><i></i></span></td>
            {COUNTRIES.map((c) => {
              const v = st.share[c.k] ?? 0;
              const used = st.used?.includes(c.k);
              return (
                <td class="c" data-rgb={rgb(c.k)} data-share={v} title={(ja ? st.noteJa : st.note) || undefined}>
                  {fmt(v)}{used && <span class="used"> ●</span>}
                </td>
              );
            })}
          </tr>
        ))}
        <tr class="tot">
          <td class="m"><span class="nm">{T.total}</span></td>
          {COUNTRIES.map((c) => <td class="c" data-rgb={rgb(c.k)} data-k={c.k}></td>)}
        </tr>
      </tbody>
    </table>
  </div>
  <p class="key">{T.key}</p>
</div>
<style>
  .levmap { --lm-bg: #fff; max-width: 900px; margin: 0 auto; font-family: ui-sans-serif, system-ui, sans-serif; color: var(--post-text, #353535); }
  :global(.dark) .levmap { --lm-bg: #000; }
  .levmap .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .levmap table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.74rem; min-width: 640px; font-variant-numeric: tabular-nums; }
  .levmap th, .levmap td { border: 1.5px solid var(--lm-bg); background-clip: padding-box; }
  .levmap th { font-weight: 600; color: var(--post-caption, #737373); padding: 2px 3px; text-align: center; font-size: 0.68rem; line-height: 1.2; vertical-align: bottom; max-width: 5.5em; }
  .levmap th .abbr { display: none; }
  .levmap th.m, .levmap td.m { text-align: left; position: sticky; left: 0; z-index: 1; background: var(--lm-bg); min-width: 9.5em; max-width: 12em; }
  .levmap td { text-align: center; padding: 4px 2px; border-radius: 4px; white-space: nowrap; transition: background-color 0.2s, color 0.2s; }
  .levmap td.m { font-weight: 600; white-space: normal; padding-right: 6px; line-height: 1.2; }
  .levmap td.c { background-color: var(--post-code-bg, #f5f5f5); }
  .levmap td[title] { cursor: help; }
  .levmap .nm { display: block; }
  .levmap .wbar { display: block; height: 3px; margin-top: 3px; background: var(--post-separator, #e5e5e5); border-radius: 2px; overflow: hidden; }
  .levmap .wbar i { display: block; height: 100%; width: 0; background: #6a4c93; transition: width 0.2s; }
  .levmap .used { font-size: 0.85em; }
  .levmap tr.tot td { border-top: 6px solid var(--lm-bg); font-weight: 700; padding: 6px 2px; }
  .levmap tr.tot td.m { color: var(--post-heading, #1a1a1a); }
  .levmap .key { font-size: 0.78rem; color: var(--post-caption, #737373); text-align: center; margin: 0.4rem 0 0; }
  .levmap .lm-slider { display: block; margin-bottom: 0.3rem; }
  .levmap .lm-ends { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.78rem; color: var(--post-caption, #737373); }
  .levmap .lm-val { font-weight: 600; color: var(--post-heading, #1a1a1a); text-align: center; }
  .levmap .lm-s { width: 100%; accent-color: #6a4c93; }
  .levmap .lm-read { text-align: center; font-size: 0.9rem; margin: 0.2rem 0 0.5rem; }
  .levmap .lm-read b { color: var(--post-heading, #1a1a1a); }
  @media (max-width: 600px) {
    .levmap table { min-width: 560px; font-size: 0.7rem; }
    .levmap th .full { display: none; }
    .levmap th .abbr { display: inline; }
    .levmap th.m, .levmap td.m { min-width: 7.5em; }
    .levmap .lm-ends { flex-wrap: wrap; }
    .levmap .lm-val { order: 3; flex-basis: 100%; }
  }
</style>
<script>
  import { DEFAULTS, STAGES, COUNTRIES, stageWeight, leverage, middlePowerLeverage, setShared, onShared, getShared } from './physical-share/model';
  const AMAX = 0.85;
  const shade = (td: HTMLElement, a: number) => {
    td.style.backgroundColor = a > 0.005 ? `rgba(${td.dataset.rgb}, ${a.toFixed(3)})` : '';
    td.style.color = a > 0.5 ? '#fff' : '';
  };
  const pct = (v: number) => Math.round(v * 100);
  document.querySelectorAll<HTMLElement>('.levmap').forEach((root, idx) => {
    const ja = root.dataset.lang === 'ja';
    const input = root.querySelector<HTMLInputElement>('.lm-s')!;
    const val = root.querySelector<HTMLElement>('.lm-val')!;
    const read = root.querySelector<HTMLElement>('.lm-read')!;
    const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('tr[data-i]'));
    const totals = Array.from(root.querySelectorAll<HTMLElement>('tr.tot td[data-k]'));
    const src = `levmap-${idx}`;
    function render(s: number) {
      input.value = String(s);
      const X = Math.round(s * 100);
      val.textContent = ja ? `新しい物理的な設備が必要な割合：${X}%` : `${X}% of progress needs new physical things`;
      const ws = STAGES.map((st) => stageWeight(st, s));
      const wMax = Math.max(...ws) || 1;
      rows.forEach((tr) => {
        const rel = ws[Number(tr.dataset.i)] / wMax;
        tr.querySelector<HTMLElement>('.wbar i')!.style.width = `${(rel * 100).toFixed(1)}%`;
        tr.querySelectorAll<HTMLElement>('td[data-share]').forEach((td) => {
          shade(td, AMAX * (parseFloat(td.dataset.share!) / 100) * rel);
        });
      });
      const tv = COUNTRIES.map((c) => leverage(s, [c.k]));
      const tMax = Math.max(...tv) || 1;
      totals.forEach((td, i) => {
        const v = tv[i];
        td.textContent = v <= 0 ? '' : v < 0.005 ? '<1%' : `${pct(v)}%`;
        shade(td, AMAX * (v / tMax));
      });
      const U = pct(leverage(s, ['US']));
      const C = pct(leverage(s, ['CN']));
      const M = pct(middlePowerLeverage(s));
      read.innerHTML = ja
        ? `割合${X}%では、加重したサプライチェーンのうち米国<b>${U}%</b>、中国<b>${C}%</b>、ミドルパワー合計<b>${M}%</b>`
        : `At ${X}%: US <b>${U}%</b>, China <b>${C}%</b>, middle powers combined <b>${M}%</b> of the weighted supply chain`;
    }
    input.addEventListener('input', () => { const s = parseFloat(input.value); render(s); setShared(s, src); });
    onShared(src, render);
    render(typeof window !== 'undefined' ? getShared() : DEFAULTS.s);
  });
</script>
