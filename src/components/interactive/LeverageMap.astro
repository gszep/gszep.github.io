---
interface Props { lang?: 'en' | 'ja' }
const { lang = 'en' } = Astro.props;
type Cell = { v: string; s: number; used?: boolean; kind?: 'red' | 'amber' | 'blue'; note?: string; nj?: string };
type Row = { m: string; mj: string; cells: Record<string, Cell> };
const cols = [
  ['CN', 'China', '中国'], ['JP', 'Japan', '日本'], ['TW', 'Taiwan', '台湾'], ['US', 'US', '米国'],
  ['CD', 'DRC', 'コンゴ民主共和国'], ['ID', 'Indonesia', 'インドネシア'], ['GULF', 'Qatar / Gulf', 'カタール・湾岸'], ['RU', 'Russia', 'ロシア'],
];
const rows: Row[] = [
  { m: 'Gallium (primary)', mj: 'ガリウム（一次生産）', cells: { CN: { v: '~99%', s: 0.95, used: true, kind: 'red', note: 'Export licensing since 2023; US ban Dec 2024, paused to Nov 2026', nj: '2023年から輸出許可制。2024年12月に対米禁輸、2026年11月まで停止' } } },
  { m: 'Magnet rare earths (refining)', mj: '磁石用レアアース（精製）', cells: { CN: { v: '~91%', s: 0.91, used: true, kind: 'red', note: 'Seven heavy REEs controlled since Apr 2025; Japan cut off Jan 2026', nj: '2025年4月から重希土類7元素を規制。2026年1月から日本向けを停止' }, US: { v: 'rising', s: 0.12, kind: 'blue' } } },
  { m: 'Battery graphite', mj: '電池用黒鉛', cells: { CN: { v: '~94%', s: 0.94, used: true, kind: 'red' } } },
  { m: 'Tungsten (mining)', mj: 'タングステン（採掘）', cells: { CN: { v: '~80%', s: 0.8, used: true, kind: 'red', note: '15 licensed exporters for 2026–27', nj: '2026〜27年の輸出許可企業は15社' } } },
  { m: 'Cobalt (mine / refine)', mj: 'コバルト（採掘・精製）', cells: { CN: { v: '79% refine', s: 0.79, kind: 'red' }, CD: { v: '>70% mine', s: 0.72, used: true, kind: 'red', note: 'Export quota 87,000 t/yr plus up to 9,600 t discretionary strategic quota, 2026–27', nj: '2026〜27年の輸出枠は年8.7万トン＋裁量的な戦略枠最大9,600トン' } } },
  { m: 'Copper (refining)', mj: '銅（精錬）', cells: { CN: { v: '~47%', s: 0.47, kind: 'red' } } },
  { m: 'Nickel (refining)', mj: 'ニッケル（精製）', cells: { CN: { v: 'owns ~75%', s: 0.3, kind: 'red', note: 'Chinese firms own about 75% of Indonesian nickel refining capacity', nj: 'インドネシアのニッケル精製能力の約75%を中国企業が保有' }, ID: { v: 'top', s: 0.6, used: true, kind: 'red', note: 'Ore quota (RKAB) cut for 2026', nj: '2026年の鉱石生産枠（RKAB）を削減' } } },
  { m: 'Sulfur / sulfuric acid', mj: '硫黄・硫酸', cells: { CN: { v: '>40% of acid output', s: 0.42, used: true, kind: 'red', note: 'By-product acid exports halted 1 May 2026', nj: '2026年5月1日から副産物硫酸の輸出を停止' }, GULF: { v: '~⅓ sulfur', s: 0.5, used: true, kind: 'amber', note: 'Hormuz disruption', nj: 'ホルムズ海峡の混乱' }, RU: { v: 'export ban', s: 0.3, used: true, kind: 'amber' } } },
  { m: 'Helium', mj: 'ヘリウム', cells: { US: { v: 'largest', s: 0.4, kind: 'blue' }, GULF: { v: '~⅓', s: 0.55, used: true, kind: 'amber', note: 'Ras Laffan struck March 2026', nj: '2026年3月にラスラファンが攻撃を受ける' } } },
  { m: 'Silicon wafers', mj: 'シリコンウェハー', cells: { JP: { v: '~44%', s: 0.44, kind: 'blue' }, TW: { v: '#3', s: 0.18, kind: 'blue' } } },
  { m: 'Photoresist', mj: 'フォトレジスト', cells: { JP: { v: '~75%', s: 0.75, used: true, kind: 'blue', note: 'Licensing tightened against Korea in 2019', nj: '2019年に韓国向けの輸出管理を厳格化' } } },
  { m: 'T-glass cloth', mj: 'Tガラスクロス', cells: { JP: { v: '~85%', s: 0.85, kind: 'blue' }, TW: { v: 'scaling', s: 0.18, kind: 'blue' } } },
  { m: 'ABF substrate film', mj: 'ABF絶縁フィルム', cells: { JP: { v: '>95%', s: 0.95, used: true, kind: 'blue', note: 'Ajinomoto cut supply to mainland China by 30% in Aug 2026 (commercial allocation)', nj: '2026年8月に味の素が中国本土向け供給を30%削減したと報道（商業的配分）' } } },
  { m: 'Precision strain-wave reducers', mj: '精密波動歯車減速機', cells: { JP: { v: '~80%', s: 0.8, kind: 'blue', note: 'Harmonic Drive Systems; Chinese makers (Leaderdrive) scaling fast', nj: 'ハーモニック・ドライブ・システムズ。中国メーカー（Leaderdrive）が急拡大' }, CN: { v: 'scaling', s: 0.25, kind: 'red' } } },
  { m: 'High-purity quartz', mj: '高純度石英', cells: { US: { v: 'dominant', s: 0.85, kind: 'blue', note: 'Spruce Pine, North Carolina', nj: 'ノースカロライナ州スプルースパイン' } } },
];
const VJ: Record<string, string> = { 'rising': '拡大中', 'scaling': '増強中', 'largest': '最大', 'dominant': '支配的', 'owns ~75%': '約75%を保有', '>40% of acid output': '硫酸生産の40%超', 'export ban': '輸出禁止', '79% refine': '精製79%', '>70% mine': '採掘70%超', 'top': '首位', '#3': '3位', '~⅓ sulfur': '硫黄の約⅓' };
const rgb: Record<string, string> = { red: '209,73,91', amber: '237,174,73', blue: '48,99,142' };
const T = {
  en: { mat: 'Material (controlling stage)', used: '● = supply restricted 2019–26 (policy, quota, war or commercial allocation). Hover a cell for detail.' },
  ja: { mat: '素材（支配的な工程）', used: '● = 2019〜26年に供給制限あり（政策・割当・戦争・商業的配分）。セルにカーソルを合わせると詳細を表示。' },
}[lang];
---
<div class="levmap">
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th class="m">{T.mat}</th>
          {cols.map(([, en, ja]) => <th>{lang === 'ja' ? ja : en}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="m">{lang === 'ja' ? r.mj : r.m}</td>
            {cols.map(([k]) => {
              const c = r.cells[k];
              if (!c) return <td class="empty"></td>;
              const a = Math.max(0.15, c.s);
              const dark = a > 0.55;
              return (
                <td style={`background: rgba(${rgb[c.kind ?? 'red']}, ${a}); color: ${dark ? '#fff' : 'inherit'}`} title={(lang === 'ja' ? c.nj : c.note) ?? ''}>
                  {lang === 'ja' ? (VJ[c.v] ?? c.v) : c.v}{c.used && <span class="used"> ●</span>}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="key">{T.used}</p>
</div>
<style>
  .levmap { max-width: 900px; margin: 0 auto; font-family: ui-sans-serif, system-ui, sans-serif; }
  .levmap .scroll { overflow-x: auto; }
  .levmap table { width: 100%; border-collapse: separate; border-spacing: 3px; font-size: 0.78rem; min-width: 680px; }
  .levmap th { font-weight: 600; color: var(--post-caption, #737373); padding: 2px 4px; text-align: center; font-size: 0.72rem; }
  .levmap th.m, .levmap td.m { text-align: left; }
  .levmap td { text-align: center; padding: 5px 3px; border-radius: 4px; white-space: nowrap; color: var(--post-text, #353535); }
  .levmap td.m { font-weight: 600; white-space: normal; }
  .levmap td.empty { background: var(--post-code-bg, #f5f5f5); }
  .levmap td[title]:not([title='']) { cursor: help; }
  .levmap .key { font-size: 0.78rem; color: var(--post-caption, #737373); text-align: center; margin: 0.4rem 0 0; }
</style>
