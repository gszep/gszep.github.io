---
import { incidents, clusteredIncidents, jobs, counts, events, rules, originLabels, screened, excluded, type Locale } from './incident-response-evidence';
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props;
const copy = {
  en: {
    eyebrow: 'Documentation coverage · 19 selected incidents',
    title: 'What the records cover',
    numerator: 'cases with explicit evidence in this collection',
    sharedLabel: 'One row per case · similar evidence patterns grouped together',
    legend: 'Recorded evidence',
    blank: 'Not coded in inspected records',
    caption: 'Recorded work, not verified completion. A full row can combine different organisations. Pale cells do not mean “not done”; the columns are not a required sequence.',
    fullCaption: 'Purposively selected examples, not a representative sample. One row per incident, in the order below; a case can involve several jobs. These counts are not a response-quality score. Not coded is not evidence of absence.',
    clustering: 'Rows use average-linkage clustering with Hamming distance on four equally weighted binary codes. Identical patterns are grouped; ties use case IDs. Branch orientation minimizes the joining distance, with ID tie-breaking. This is a display order, not a quality ranking or a finding that responses followed the same process. The evidence and inclusion rules are unchanged.',
    select: 'Inspect a case',
    php: 'PHP highlighted',
    chart: '19 case rows and four equal-width evidence columns, clustered by pattern. PHP is outlined. Use the case selector or the source table for each row’s details.',
    readout: 'Selected case evidence',
    yes: 'Recorded',
    no: 'Not coded',
    details: 'Sources, coding rules and all 19 cases',
    method: `${screened} incidents screened; 19 qualified and one did not. Cases were deliberately selected for informative response sequences and available public records. This favours well-documented incidents. Counts describe the inspected records—not prevalence, importance, effectiveness or completeness.`,
    provenance: 'Evidence includes current pages, retrospective accounts and dated or archived records. A current page’s account of a revision does not establish when earlier readers saw either wording. Statements, tools and reported actions do not establish installation, uptake or protection. No new source retrieval was performed for this figure.',
    matrix: 'Source matrix · same clustered row order',
    scroll: 'The source matrix can be scrolled horizontally. Each positive cell names its reviewed event and public source; unfilled cells mean no code in the bounded records inspected.',
    noCode: 'Not coded in inspected records',
    case: 'Incident', source: 'Source',
    columns: {
      scope: { title: 'Local scope', insight: 'The same warning can mean different things for different systems.', example: 'xz: Debian distinguished affected branches.' },
      revision: { title: 'Updated assessment', insight: 'An actor acknowledges changing an assessment or advice. This includes discovery reasoning, not only public corrections.', example: 'OpenSSL 2022: severity revised down.' },
      help: { title: 'Practical help', insight: 'A specific tool, procedure or notification can address a practical obstacle.', example: 'Heartbleed: targeted host lists + a guide.' },
      remaining: { title: 'Remaining work', insight: 'One completed step need not finish the response.', example: 'Citrix Bleed: end sessions too.' },
    },
  },
  ja: {
    eyebrow: '記録のカバー範囲・選んだ19事例',
    title: '記録で確認できること',
    numerator: '今回の収集で明確な記録を確認できた事例',
    sharedLabel: '1行が1事例。記録の組み合わせが似た事例を並べています。',
    legend: '該当する記録あり',
    blank: '調べた記録では分類せず',
    caption: '仕事の記録であり、完了の確認ではありません。一行に複数の組織の記録をまとめている場合があります。淡い色は「未実施」の意味ではなく、列も必須の順序ではありません。',
    fullCaption: '目的に沿って選んだ事例であり、全体を代表する標本ではありません。一つの行が一事例で、下の一覧と同じ順序です。一事例が複数の仕事に該当します。対応の良し悪しを採点したものではありません。分類しなかったことは、実施されなかった証拠ではありません。',
    clustering: '四つの分類を同じ重みの二値データとし、ハミング距離と平均連結法で似た行をまとめています。同じ組み合わせは隣り合い、同距離の場合は事例IDで順序を決めます。各結合では境界の距離が小さくなる向きを選び、同点はID順です。見やすくするための並び順であり、成績や共通の対応手順を示すものではありません。根拠と採用条件は変更していません。',
    select: '事例を確認',
    php: 'PHPを強調',
    chart: '19事例を行、四つの仕事を同じ幅の列にした図。記録の組み合わせで並べ、PHPを枠で強調しています。事例の選択欄と出典一覧で各行を確認できます。',
    readout: '選んだ事例の記録',
    yes: '記録あり',
    no: '分類せず',
    details: '出典・分類基準と19事例の一覧',
    method: `${screened}事例を調べ、19事例が採用条件を満たし、1事例は満たしませんでした。対応の経緯を読み取れることと、公開資料があることを重視して選んだため、記録の豊富な事例に偏っています。数値は調べた記録の件数であり、一般的な頻度、重要性、有効性、網羅性を示しません。`,
    provenance: '現行ページ、後日の報告、日付付き資料や保存版を使っています。現行ページに変更の説明があっても、当時の読者がいつどの文面を見たかは分かりません。説明やツールの公開、対応の自己報告は、導入・利用・保護の達成を保証しません。この図の作成時に出典を再取得してはいません。',
    matrix: '出典一覧：図と同じ並び順',
    scroll: '一覧は横にスクロールできます。該当する各欄には、確認済み記録のIDと公開出典を示しています。白抜きの欄は、調べた限りでは分類しなかったことを意味します。',
    noCode: '調べた記録では分類せず',
    case: '事例', source: '出典',
    columns: {
      scope: { title: '影響を見極める', insight: '同じ警告でも、使っているシステムによって意味は変わります。', example: 'xz：Debianは対象の系統を区別。' },
      revision: { title: '判断を更新する', insight: '発信者自身が判断や助言の変更を明示します。公開後の訂正だけでなく、発見の過程での見直しも含みます。', example: 'OpenSSL（2022年）：深刻度を引き下げ。' },
      help: { title: '行動を手伝う', insight: '具体的なツールや手順、個別の通知で、対応を妨げる問題に対処できます。', example: 'Heartbleed：対象ホスト一覧と復旧案内。' },
      remaining: { title: '残る仕事を示す', insight: '一つの作業が済んでも、対応全体が終わるとは限りません。', example: 'Citrix Bleed：セッション終了も推奨。' },
    },
  },
};
const t = copy[lang];
const caseName = (name: string) => lang === 'ja' ? name.replace('November 2022', '2022年11月') : name;
---

<div class="incident-hero" lang={lang} role="group" aria-label={t.title} data-incident-heatmap>
  <header>
    <p class="hero-eyebrow">{t.eyebrow}</p>
    <h2 class="hero-heading">{t.title}</h2>
    <p class="shared-label">{t.sharedLabel}</p>
  </header>
  <div class="heatmap-head">
    {jobs.map(job => <div><span>{t.columns[job].title}</span><small>{counts[job]} / {incidents.length}</small></div>)}
  </div>
  <div class="heatmap-body" role="img" aria-label={t.chart}>
    <div class="heatmap-rows" aria-hidden="true">
      {clusteredIncidents.map(incident => <div class:list={['heat-row', { 'php-row': incident.id === 'php-2026' }]} data-heatmap-row={incident.id} title={caseName(incident.name)}>
        {incident.id === 'php-2026' && <span class="php-label">PHP</span>}
        {jobs.map(job => <span class:list={['heat-cell', { filled: incident.codes[job] !== null }]} data-job={job} data-coded={String(incident.codes[job] !== null)}></span>)}
      </div>)}
    </div>
  </div>
  <div class="hero-caption">
    <p class="hero-legend"><span><i class="legend-cell filled" aria-hidden="true"></i>{t.legend}</span><span><i class="legend-cell" aria-hidden="true"></i>{t.blank}</span><span><i class="legend-php" aria-hidden="true"></i>{t.php}</span></p>
    <p>{t.caption}</p>
  </div>
  <div class="case-inspector">
    <label for={`incident-case-${lang}`}>{t.select}</label>
    <select id={`incident-case-${lang}`} data-case-select aria-controls={`incident-reading-${lang}`}>
      {clusteredIncidents.map(incident => <option value={incident.id} selected={incident.id === 'php-2026'}>{caseName(incident.name)}</option>)}
    </select>
    <div id={`incident-reading-${lang}`} class="case-readings sr-only" aria-live="polite" aria-label={t.readout}>
      {clusteredIncidents.map(incident => <div data-case-reading={incident.id} hidden={incident.id !== 'php-2026'}>
        <div class="reading-grid">{jobs.map(job => <span class:list={{ 'not-coded': incident.codes[job] === null }}><span aria-hidden="true">{incident.codes[job] ? '●' : '○'}</span> {t.columns[job].title}: {incident.codes[job] ? t.yes : t.no}</span>)}</div>
      </div>)}
    </div>
  </div>
  <details class="hero-methods">
    <summary>{t.details}</summary>
    <div class="method-body">
      <p>{t.method}</p>
      <p>{t.fullCaption}</p>
      <p>{t.clustering}</p>
      <p>{excluded.reason[lang]}</p>
      <dl class="coding-rules">
        {jobs.map(job => <div><dt>{t.columns[job].title}</dt><dd>{t.columns[job].insight} {rules[job][lang]}</dd></div>)}
      </dl>
      <p>{t.provenance}</p>
      <p>{t.scroll}</p>
      <div class="matrix-scroll" role="region" aria-label={t.matrix} tabindex="0">
        <table>
          <caption>{t.matrix}</caption>
          <thead><tr><th scope="col">{t.case}</th>{jobs.map(job => <th scope="col">{t.columns[job].title}</th>)}</tr></thead>
          <tbody>
            {clusteredIncidents.map((incident, index) => <tr data-case={incident.id}>
              <th scope="row"><span class="row-number">{String(index + 1).padStart(2, '0')}</span>{caseName(incident.name)}<small>{incident.id}</small></th>
              {jobs.map(job => {
                const entry = incident.codes[job];
                return <td class={`job-${job}`}>
                  <span class:list={['case-mark', { filled: entry !== null }]} aria-hidden="true"></span>
                  {entry ? <>
                    <p>{entry.note[lang]}</p>
                    <ul>{entry.eventIds.map(eventId => <li>
                      <a href={events[eventId].url}>{t.source}: {eventId}</a>
                      <small>{originLabels[events[eventId].origin][lang]}</small>
                    </li>)}</ul>
                  </> : <p class="not-coded">{t.noCode}</p>}
                </td>;
              })}
            </tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </details>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-incident-heatmap]')) {
    const select = root.querySelector<HTMLSelectElement>('[data-case-select]');
    if (!select) continue;
    const update = (id: string) => {
      select.value = id;
      for (const row of root.querySelectorAll<HTMLElement>('[data-heatmap-row]')) row.classList.toggle('selected-row', row.dataset.heatmapRow === id && id !== 'php-2026');
      for (const reading of root.querySelectorAll<HTMLElement>('[data-case-reading]')) reading.hidden = reading.dataset.caseReading !== id;
    };
    select.addEventListener('change', () => update(select.value));
    // Tiny visual rows are optional pointer shortcuts. The 44px native selector
    // and full source table provide the equivalent touch/keyboard interaction.
    for (const row of root.querySelectorAll<HTMLElement>('[data-heatmap-row]')) row.addEventListener('click', () => update(row.dataset.heatmapRow!));
  }
</script>

<style>
  .incident-hero { --ink: #252b2b; --muted: #505b5b; --line: #d8dcd8; --accent: #476466; margin: 0; padding: clamp(14px, 2.5vw, 24px); background: #fafaf6; color: var(--ink); border: 1px solid var(--line); border-radius: 3px; font-family: ui-sans-serif, system-ui, sans-serif; line-height: 1.5; text-align: left; color-scheme: light; }
  .incident-hero * { box-sizing: border-box; }
  .incident-hero .hero-eyebrow { margin: 0 0 .45rem; color: var(--muted); font-size: .75rem; font-weight: 650; letter-spacing: .025em; }
  .incident-hero .hero-heading { margin: 0 0 .6rem; color: var(--ink); font-size: clamp(1.25rem, 2.5vw, 1.6rem); line-height: 1.25; font-weight: 650; letter-spacing: -.025em; text-wrap: balance; }
  .incident-hero .shared-label { margin: 0 0 1rem; color: var(--muted); font-size: .8rem; }
  .job-scope { --accent: #32696a; }
  .job-revision { --accent: #81583d; }
  .job-help { --accent: #526644; }
  .job-remaining { --accent: #68577f; }
  .heatmap-head { margin-left: 36px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; margin-bottom: 12px; }
  .heatmap-head > div { min-width: 0; padding-right: 3px; font-size: .78rem; line-height: 1.3; font-weight: 650; }
  .incident-hero .heatmap-head small { font-variant-numeric: tabular-nums; margin-top: 5px; font-size: .75rem; }
  .heatmap-body { margin-left: 36px; }
  .heatmap-rows { display: grid; gap: 2px; }
  .heat-row { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; height: 8px; cursor: pointer; }
  .heat-cell, .legend-cell { background: #e4e9e5; border: 1px solid #cbd5cf; }
  .heat-cell.filled, .legend-cell.filled { background: #32696a; border-color: #32696a; }
  .php-row { outline: 1.5px solid #9a590d; outline-offset: 1px; z-index: 1; }
  .php-label { position: absolute; right: calc(100% + 8px); top: -3px; color: #854b09; font-size: 10px; line-height: 14px; font-weight: 750; }
  .selected-row { outline: 1.5px solid #172d36; outline-offset: 1px; z-index: 2; }
  .case-mark { display: inline-block; flex-shrink: 0; width: 9px; height: 9px; border: 1px solid var(--accent); border-radius: 50%; background: transparent; }
  .case-mark.filled { background: var(--accent); }
  .incident-hero .hero-caption { margin: 1rem 0 0; color: var(--muted); font-size: .76rem; line-height: 1.5; text-align: left; }
  .incident-hero .hero-caption p { margin: .4rem 0; }
  .hero-legend { display: flex; flex-wrap: wrap; gap: .4rem 1rem; align-items: center; }
  .hero-legend > span { display: inline-flex; gap: 6px; align-items: center; }
  .legend-cell, .legend-php { display: inline-block; width: 12px; height: 8px; }
  .legend-php { border: 1.5px solid #9a590d; }
  .case-inspector { margin-top: 14px; font-size: .8rem; }
  .case-inspector label { display: block; font-size: .75rem; color: var(--muted); margin-bottom: 3px; }
  .case-inspector select { width: 100%; min-height: 44px; border: 1px solid var(--line); border-radius: 3px; background: #fff; color: var(--ink); padding: 6px 10px; font: inherit; }
  .reading-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3px 12px; margin-top: 8px; font-size: .72rem; color: #32696a; }
  .case-readings [hidden] { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .case-inspector select:focus-visible { outline: 3px solid #32696a; outline-offset: 3px; }
  .hero-methods { margin-top: .65rem; border-top: 1px solid var(--line); font-size: .83rem; }
  .hero-methods summary { cursor: pointer; padding: .8rem 0 0; color: var(--ink); font-weight: 600; min-height: 44px; }
  .hero-methods summary:focus-visible, .matrix-scroll:focus-visible, .incident-hero a:focus-visible { outline: 3px solid #32696a; outline-offset: 4px; }
  .incident-hero .method-body p { margin: 1rem 0; }
  .coding-rules { margin: 1rem 0; }
  .coding-rules div { margin: .9rem 0; }
  .coding-rules dt { font-weight: 650; }
  .coding-rules dd { margin: .2rem 0 0; }
  .matrix-scroll { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; margin-top: 1rem; }
  .incident-hero table { border-collapse: collapse; table-layout: fixed; width: 1100px; margin: 0; font-size: .78rem; line-height: 1.55; }
  .incident-hero caption { text-align: left; padding: .6rem 0; font-weight: 600; color: var(--ink); }
  .incident-hero th, .incident-hero td { padding: 14px; border: 1px solid var(--line); vertical-align: top; text-align: left; overflow-wrap: anywhere; }
  .incident-hero thead th { background: #f0f1ec; font-weight: 600; color: var(--ink); }
  .incident-hero th:first-child { width: 180px; }
  .incident-hero td p { margin: .5rem 0; }
  .incident-hero small { display: block; margin-top: .4rem; font-size: .69rem; color: var(--muted); font-weight: 400; }
  .row-number { display: block; font-size: .7rem; color: var(--muted); margin-bottom: .4rem; }
  .incident-hero td ul { padding: 0; margin: .7rem 0 0; list-style: none; }
  .incident-hero td li { margin: 0 0 .8rem; }
  .incident-hero a { color: #245a65; text-decoration: underline; text-underline-offset: 2px; }
  .not-coded { color: var(--muted); }
  @media (max-width: 420px) { .heatmap-head > div { font-size: .7rem; } .heatmap-head, .heatmap-body { margin-left: 30px; } }
  @media (forced-colors: active) { .case-mark.filled, .heat-cell.filled { background: CanvasText; forced-color-adjust: none; border-color: CanvasText; } .case-mark, .heat-cell { border-color: CanvasText; } .php-row { outline-color: Highlight; } }
</style>
