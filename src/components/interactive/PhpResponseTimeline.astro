---
import { warning, responses, maintenance, offsetSeconds, minutesBetween, durationLabel, axisEndSeconds } from './php-warning-evidence';
const { lang = 'en' } = Astro.props;
const ja = lang === 'ja';
const locale = ja ? 'ja' : 'en';
const x = (at: string) => 8 + offsetSeconds(at) / axisEndSeconds * 584;
const ticks = [0, 24, 48, 72, 96, 120];
const clock = (at: string) => at.slice(0, 16).replace('T', ' ');
const context = { JP: ja ? '日本' : 'Japan', KR: ja ? '韓国' : 'Korea', MULTIREGION: ja ? '複数地域' : 'Multiregion' };
const length = (row: typeof responses[number]) => row.kind === 'reported-restriction'
  ? `${row.approximate ? (ja ? '約' : '≈ ') : ''}${durationLabel(minutesBetween(row.start, row.end), lang)}`
  : (ja ? '? 停止時間不明' : '? duration unknown');
---
<div class="warning-comparison" data-warning-comparison>
  <h3>{ja ? '警告後、どの機能がいつ戻ったか' : 'After the warning: which function returned when?'}</h3>
  <p class="small">{ja ? '基準：2026年10月20日19:33:47 UTC、PHP開発元の公開事前警告。最初の技術情報公開とは限りません。' : 'Zero: 20 October 2026, 19:33:47 UTC, the public maintainer advance warning—not established as the first technical disclosure.'} <a href={warning.source}>{ja ? '原文' : 'Source'}</a></p>
  <div class="legend">{Object.entries(context).map(([key, text]) => <span data-locale={key}><i class="swatch"></i>{text}</span>)}</div>
  <p class="small">{ja ? '色はサービスの地域区分（国別標本ではありません）。実線＝報告された制限期間、●点線＝報告時点、◇＝通知ページの時刻、斜線帯＝日付のみの通知。?＝不明。' : 'Colours identify service context, not national samples. Solid = reported restriction; ● dotted = report checkpoints; ◇ = notice-page timestamp; hatch = date-only notice. ? = unknown.'}</p>
  <p class="small">{ja ? '破線：修正版の公開予定（警告から約18時間26分後）。実際の配布・入手時刻は不明。行に触れるか、フォーカスまたは選択すると詳細を表示します。' : 'Dashed marker: scheduled patch release (about +18h 26m). Actual release/receipt time unknown. Hover, focus or select a row for details.'}</p>
  <div class="axis-row"><span>{ja ? '警告からの時間' : 'Hours from warning'}</span><svg viewBox="0 0 600 30" aria-hidden="true">
    {ticks.filter(h => h < 120).map(h => <text x={8 + h * 3600 / axisEndSeconds * 584} y="17" text-anchor={h ? 'middle' : 'start'}>{h}</text>)}
    <text x="592" y="17" text-anchor="end">{ja ? '133時間34分' : '133h34m'}</text>
  </svg></div>
  <div class="warning-rows">
    {responses.map((row, index) => <button type="button" class="warning-row" data-row={row.id} data-locale={row.locale} aria-controls={`warning-detail-${row.id}-${lang}`}>
      <span class="row-label"><strong>{row.label[locale]}</strong><small>{context[row.locale]} · {length(row)}</small></span>
      <svg viewBox="0 0 600 42" aria-hidden="true">
        <defs><pattern id={`notice-hatch-${lang}-${index}`} width="7" height="7" patternUnits="userSpaceOnUse"><path d="M0 7L7 0" stroke="currentColor" stroke-width="1" /></pattern></defs>
        {ticks.map(h => <line x1={8 + h * 3600 / axisEndSeconds * 584} x2={8 + h * 3600 / axisEndSeconds * 584} y1="0" y2="42" class="grid" />)}
        <line x1={x(warning.scheduledRelease)} x2={x(warning.scheduledRelease)} y1="0" y2="42" class="release" />
        {row.notice?.kind === 'date-only' && <rect x={x(row.notice.start)} y="2" width={x(row.notice.endExclusive)-x(row.notice.start)} height="9" fill={`url(#notice-hatch-${lang}-${index})`} class="notice-day" />}
        {row.kind === 'reported-restriction' ? <>
          <line x1={x(row.start)} x2={x(row.end)} y1="27" y2="27" class="restriction" />
          {row.approximate && <circle cx={x(row.start)} cy="27" r="6" class="approximate" />}
        </> : <>
          <line x1={x(row.events[0].at)} x2={x(row.events.at(-1)!.at)} y1="27" y2="27" class="reports" />
          {row.events.map(event => <circle cx={x(event.at)} cy="27" r="3" fill="currentColor" />)}
        </>}
        {row.notice?.kind === 'page-timestamp' && <path d={`M${x(row.notice.at)} 2l4 5-4 5-4-5Z`} class="notice-point" />}
      </svg>
    </button>)}
  </div>
  <p class="small endpoint">{ja ? '右端：選んだ記録の最新の復旧時点、10月26日18:08（KSTと仮定）。FFXIVの2行は同一事例の別機能です。' : 'Right edge: latest restoration in the selected records, 26 October 18:08 (assumed KST). The two FFXIV rows are functions of one incident.'}</p>
  <div class="row-details">
    {responses.map(row => <section id={`warning-detail-${row.id}-${lang}`} data-detail={row.id} class="row-detail" data-locale={row.locale} aria-label={row.label[locale]}>
      <strong>{row.label[locale]} · {length(row)}</strong>
      <p>{row.scope[locale]} {row.zone} ({row.zoneExplicit ? (ja ? '明記' : 'explicit') : (ja ? '仮定' : 'assumed')})</p>
      {row.kind === 'reported-restriction' ? <p>{ja ? '事業者が報告した制限期間：' : 'Operator-reported restriction: '}{clock(row.start)} → {clock(row.end)}{row.approximate ? (ja ? '（開始は概時刻）' : ' (approximate onset)') : ''}.</p> : <>
        <ul>{row.events.map(event => <li>{clock(event.at)} UTC — {event.label[locale]}</li>)}</ul>
        <p>{ja ? '最初と最後の報告間は6時間10分。修正適用から再開の報告間は178分。停止や試験の実測時間ではありません。' : 'First-to-last report span: 6h 10m. Fix-to-reopening report gap: 178 minutes. Neither measures outage or testing duration.'}</p>
      </>}
      {row.notice && <p>{row.notice.kind === 'date-only'
        ? (ja ? `通知日：${row.notice.start.slice(0,10)}。斜線帯は現地の1日全体で、公表時刻を推定していません。通知日の時差もJSTと仮定しています。` : `Notice date: ${row.notice.start.slice(0,10)}. The hatch covers the local day, not an inferred publication instant; its timezone is assumed JST.`)
        : (ja ? `ページの時刻：${clock(row.notice.at)}。現在の本文の改訂履歴を示す時刻ではありません。` : `Page timestamp: ${clock(row.notice.at)}. This does not date every revision in the current body.`)}</p>}
      <p>{row.uncertainty[locale]} <a href={row.source}>{ja ? '事業者の原文' : 'Operator source'}</a></p>
    </section>)}
  </div>
  <section class="maintenance-context" aria-labelledby={`maintenance-title-${lang}`}>
    <h3 id={`maintenance-title-${lang}`}>{ja ? '以前の予定メンテナンス：同条件の基準ではなく、参考情報' : 'Earlier scheduled maintenance: context, not a matched baseline'}</h3>
    <p class="small">{ja ? '韓国版FFXIVのゲーム・ランチャー。別軸：各回の予定開始からの時間。枠線＝予定、塗り＝本文が報告する完了期間。KSTと仮定。' : 'Korean FFXIV game/launcher. Separate axis: hours from each scheduled start. Outline = planned; fill = completed window reported in the body. KST assumed.'}</p>
    <div class="axis-row"><span>{ja ? '予定開始からの時間' : 'Hours from scheduled start'}</span><svg viewBox="0 0 600 25" aria-hidden="true">{[0,1,2,3,4,5].map(h => <text x={8+h*116.8} y="17" text-anchor={h===0 ? 'start' : h===5 ? 'end' : 'middle'}>{h}</text>)}</svg></div>
    {maintenance.map(row => <div class="maintenance-row" data-maintenance={row.id}>
      <span><strong>{row.start.slice(0,10)}</strong><small>{ja ? '予定 ' : 'Plan '}{durationLabel(minutesBetween(row.start,row.plannedEnd),lang)} / {ja ? '報告 ' : 'reported '}{durationLabel(minutesBetween(row.start,row.reportedEnd),lang)}</small></span>
      <svg viewBox="0 0 600 30" role="img" aria-label={`${row.start.slice(0,10)}: ${ja ? '予定' : 'planned'} ${minutesBetween(row.start,row.plannedEnd)} min; ${ja ? '完了報告' : 'reported completed'} ${minutesBetween(row.start,row.reportedEnd)} min`}>
        <rect x="8" y="5" width={minutesBetween(row.start,row.plannedEnd)/300*584} height="20" class="planned" />
        <rect x="8" y="10" width={minutesBetween(row.start,row.reportedEnd)/300*584} height="10" class="completed" />
      </svg>
    </div>)}
    <details><summary>{ja ? '時刻と出典' : 'Times and sources'}</summary>
      {maintenance.map(row => <p>{row.start.slice(0,10)} · {clock(row.start).slice(11)}–{clock(row.plannedEnd).slice(11)} <a href={row.plan}>{ja ? '予定' : 'planned'}</a>; {clock(row.start).slice(11)}–{clock(row.reportedEnd).slice(11)} <a href={row.completion}>{ja ? '完了報告' : 'reported completed'}</a> (KST).</p>)}
      <p>{ja ? '本文には開始・終了の両時刻が記載されています。ページ作成時刻（順に18:10、18:11）は終了時刻より前なので、完了の文言が公表された時刻には使えません。独立した稼働測定ではありません。' : 'The bodies explicitly give both endpoints. Page creation times (18:10 and 18:11 respectively) precede completion and cannot date the completed wording. These are not independent uptime measurements.'}</p>
    </details>
    <p class="small">{ja ? '対象がログイン・バックアップ制限とは異なる2回の記録です。通常の停止時間の分布や、セキュリティ対応との時間比率は求めていません。' : 'These two windows cover different functions from the login/backup restrictions. They establish neither a normal-downtime distribution nor a security-to-routine downtime ratio.'}</p>
  </section>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-warning-comparison]').forEach(root => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-row]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const select = (id: string) => {
      panels.forEach(panel => { panel.hidden = panel.dataset.detail !== id; });
      buttons.forEach(button => button.setAttribute('aria-expanded', String(button.dataset.row === id)));
    };
    buttons.forEach(button => {
      const show = () => select(button.dataset.row!);
      button.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') show(); });
      button.addEventListener('focus', show);
      button.addEventListener('click', show);
    });
    select(buttons[0].dataset.row!);
  });
</script>
<style>
  .warning-comparison { --locale-jp: #2b669b; --locale-kr: #a64d29; --locale-multiregion: #6c4a91; font-family: system-ui, sans-serif; color: var(--post-text); margin: 1.5rem 0; }
  :global(.dark) .warning-comparison { --locale-jp: #8bc4f0; --locale-kr: #f0a581; --locale-multiregion: #c7a5eb; }
  h3 { color: var(--post-heading); font-size: 1.15rem; line-height: 1.4; margin: 0 0 .6rem; }
  .small, .row-detail { font-size: .82rem; line-height: 1.55; }
  .small { margin: .5rem 0; }
  [data-locale="JP"] { --locale: var(--locale-jp); }
  [data-locale="KR"] { --locale: var(--locale-kr); }
  [data-locale="MULTIREGION"] { --locale: var(--locale-multiregion); }
  .legend { display: flex; gap: 1rem; flex-wrap: wrap; font-size: .82rem; }
  .swatch { display: inline-block; width: .8rem; height: .8rem; margin-right: .4rem; background: var(--locale); }
  .axis-row, .warning-row, .maintenance-row { display: grid; grid-template-columns: minmax(180px, 29%) minmax(0, 1fr); align-items: center; gap: .5rem; }
  .axis-row { font-size: .72rem; color: var(--post-caption); }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  svg text { font-size: 12px; fill: var(--post-caption); }
  .warning-row { width: 100%; text-align: left; background: var(--post-pre-bg); border: 0; border-top: 1px solid var(--post-separator); padding: .4rem .25rem; color: var(--locale); cursor: pointer; font: inherit; }
  .row-label strong, .maintenance-row strong { display: block; font-size: .82rem; line-height: 1.4; }
  small { display: block; font-size: .72rem; color: var(--post-caption); line-height: 1.5; }
  .warning-row:hover, .warning-row[aria-expanded="true"] { background: var(--post-aside-bg); }
  button:focus-visible, summary:focus-visible, a:focus-visible { outline: 3px solid var(--post-link); outline-offset: 3px; }
  .grid { stroke: var(--post-separator); }
  .release { stroke: var(--post-heading); stroke-dasharray: 4 3; }
  .restriction { stroke: currentColor; stroke-width: 8; }
  .reports { stroke: currentColor; stroke-width: 1.5; stroke-dasharray: 2 3; }
  .approximate, .notice-point { fill: var(--post-pre-bg); stroke: currentColor; stroke-width: 1.5; }
  .notice-day { stroke: currentColor; stroke-width: .5; }
  .endpoint { text-align: right; }
  .row-detail { padding: .8rem 1rem; border-left: 3px solid var(--locale); background: var(--post-aside-bg); overflow-wrap: anywhere; margin-top: .7rem; }
  .row-detail[hidden] { display: none; }
  .row-detail p { margin: .4rem 0; }
  .row-detail ul { padding-left: 1.2rem; margin: .5rem 0; }
  .maintenance-context { margin-top: 1.5rem; padding: 1rem; border: 1px solid var(--post-separator); }
  .maintenance-row { margin: .6rem 0; }
  .planned { fill: none; stroke: var(--locale-kr); stroke-width: 1.5; }
  .completed { fill: var(--locale-kr); }
  details { font-size: .82rem; }
  summary { cursor: pointer; }
  @media (max-width: 600px) {
    svg text { font-size: 22px; }
    .axis-row, .warning-row, .maintenance-row { grid-template-columns: minmax(0,1fr); gap: .15rem; }
    .warning-row { padding: .6rem .25rem; }
    .row-label { display: flex; justify-content: space-between; gap: .5rem; align-items: baseline; }
    .row-label small { text-align: right; }
    .maintenance-context { padding: .75rem; }
  }
  @media print { .row-detail[hidden] { display: block; } }
</style>
